				</gf>
				<units>unitless</units>
			</aux>
			<aux name="Converter 4">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>0.80</eqn>
				</element>
				<element subscript="Costa">
					<eqn>1.7</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Entrada Forzada Baterias">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>0</eqn>
				</element>
				<element subscript="Costa">
					<eqn>0</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Entrada Forzada Solar DG">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>IF TIME = 132 THEN
0
ELSE
0</eqn>
				</element>
				<element subscript="Costa">
					<eqn>IF TIME = 132 THEN
0 
ELSE
0</eqn>
				</element>
				<units>MW/month</units>
			</aux>
			<aux name="Total Horas Carga" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>unitless</units>
			</aux>
			<stock name="Capacidad Baterias Distribuidas" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Entrada_Capacidad_Baterias_Dist</inflow>
				<units>MW</units>
			</stock>
			<aux name="Horas Carga Bateria">
				<eqn>Total_Horas_Carga</eqn>
				<units>unitless</units>
			</aux>
			<flow name="Entrada Capacidad Baterias Dist">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>SAFEDIV(Entrada_Nuevas_Baterias, Horas_Carga_Bateria, 0) / Ajuste_Unidad_Vatios*0</eqn>
				<non_negative/>
				<units>MW/month</units>
			</flow>
			<aux name="Total Baterias Distribuidas">
				<eqn>SUM(Capacidad_Baterias_Distribuidas)</eqn>
				<units>MW</units>
			</aux>
			<aux name="Converter 5">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>IF TIME = 120 THEN
200000
ELSE
0</eqn>
				</element>
				<element subscript="Costa">
					<eqn>0</eqn>
				</element>
				<units>Casa/Month</units>
			</aux>
