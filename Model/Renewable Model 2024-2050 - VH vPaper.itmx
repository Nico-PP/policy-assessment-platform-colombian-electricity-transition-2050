				<element subscript="1, H20">
					<eqn>Capacidad_Instalada[Gas] * FC_Termicas_Horario[H20] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="1, H21">
					<eqn>Capacidad_Instalada[Gas] * FC_Termicas_Horario[H21] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="1, H22">
					<eqn>Capacidad_Instalada[Gas] * FC_Termicas_Horario[H22] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="1, H23">
					<eqn>Capacidad_Instalada[Gas] * FC_Termicas_Horario[H23] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="2, H0">
					<eqn>Capacidad_Instalada[Oil] * FC_Termicas_Horario[H0] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="2, H1">
					<eqn>Capacidad_Instalada[Oil] * FC_Termicas_Horario[H1] * Ajuste_Unidad_Gen_12_horas</eqn>
