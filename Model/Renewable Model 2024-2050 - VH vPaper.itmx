				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Energia Eolica Enviada">
				<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro[Element_16,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Faltantes Energia Centro Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Demanda_Centro_24h - Capacidad_Total_Centro_Disponible)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Porcentaje Faltantes">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Faltantes_Energia_Centro_Horas, SUM(Faltantes_Energia_Centro_Horas), 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Suma Faltantes">
				<eqn>SUM(Faltantes_Energia_Centro_Horas)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Costa Disponible 2">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Aux_Gen_Dips_Costa</eqn>
