			<aux name="Demanda Total Costa" access="output">
				<eqn>SUM(Demanda_Costa_24h[*])</eqn>
				<isee:summing/>
				<units>MWh</units>
			</aux>
			<aux name="FC Costa Wind Ajustado" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>FC_Costa_Wind_Horario/SUM(FC_Costa_Wind_Horario)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Disponible Costa por Tecnologia">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>SUM(stage3_Generacion_disponible_Costa_Dia_Horas[Indice_Tec,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Solar\nDistribuida Costa" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Autoregeneracion_Costa_por_Horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Solar DG Costa">
				<eqn>SUM(Autoregeneracion_Costa_por_Horas)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion por Tecnologia\nHora Costa Noche">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa_Horas * Factor_Noche[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Factor Noche" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Factor Dia" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion por Tecnologia\nHora Costa Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa_Horas * Factor_Dia[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Hidro Centro a Costa Noche">
				<eqn>SUM(Exportar_Hidro_Noche)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Switch Off Hidro" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
