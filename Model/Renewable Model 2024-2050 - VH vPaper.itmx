			<aux name="Disponibilidad Eolica Onshore">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Copia_Generacion_disponible_Costa_Dia_Horas[5,Horas24] - Exportacion_Eolica_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad Solar">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Copia_Generacion_disponible_Costa_Dia_Horas[7,Horas24] - Exportacion_Solar_Costa_a_Centro_Dia</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Copia Generacion disponible\nCosta Dia Horas 1" access="input">
				<dimensions>
