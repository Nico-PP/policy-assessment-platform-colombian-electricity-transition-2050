			<aux name="Converter 1">
				<eqn>SUM(Tec1_Gen_Dispo)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Distribucion Horas" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Suma Distribucion">
				<eqn>SUM(Distribucion_Horas_1)</eqn>
				<units>unitless</units>
