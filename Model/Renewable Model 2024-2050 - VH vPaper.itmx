			<aux name="Demanda" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Suma Gen">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SUM(Generacion_Tecnologias[*,Horas24])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen vs Bolsa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Suma_Gen-Bolsa_Inicial</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Costo Despacho Ordenado\nCentro Tec x Time">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Costo_para_Despacho_Ordenado[Indice_Tec]</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Precio Electricidad\nCentro Tec x Time">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Precio_Electricidad[Horas24]</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Gen Dia 9">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[9, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[9, Horas24]=2)THEN (
        IF(Ad_Bolsa_8&gt;Generacion_Odernada[9, Horas24]) THEN
           Generacion_Odernada[9, Horas24]
        ELSE
           Ad_Bolsa_8 )
     ELSE
       Generacion_Odernada[9, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bolsa 9">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[9, Horas24]=1)THEN
   0
ELSE(
   IF(Indice_Precios[9, Horas24]=2)THEN
      IF(Ad_Bolsa_8&gt;Gen_Dia_9)THEN
         (Ad_Bolsa_8-Gen_Dia_9)
       ELSE( 0)
    ELSE (Ad_Bolsa_8-Gen_Dia_9)
)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 10">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
