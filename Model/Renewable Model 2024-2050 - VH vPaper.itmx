			</aux>
			<aux name="Converter 12">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SUM(Generacion_por_Tecnologia_Costa_Horas_1[*,Horas24])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Converter 13">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda_Merito_Costa_Dia_24h - Converter_12</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Converter 14">
				<eqn>SUM(Converter_13)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Viento Offshore">
				<eqn>Capacidad_Instalada[Wind_Offshore]</eqn>
				<units>MW</units>
			</aux>
			<aux name="Molinos Disponibles Offshore">
				<eqn>Capacidad_Viento_Offshore/Capacidad_Molino_Offshore</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Energía Series viento\nTotal Offshore">
				<eqn>MIN(Molinos_Disponibles_Offshore*Potencia_Viento_Offshore,  Capacidad_Viento_Offshore)*Horas_Dias*To_MWH * Factor_de_carga_eolica_Offshore</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Factor de carga\neolica Offshore" access="output">
				<eqn>0.6</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Ajuste unidad MWh" access="input">
				<eqn>1</eqn>
				<units>MW * hr / MWh</units>
			</aux>
			<aux name="Unidad MWh">
				<eqn>Ajuste_unidad_MWh</eqn>
				<units>MW * hr / MWh</units>
			</aux>
			<aux name="Uso Gas Total">
				<eqn>SUM(Generacion_por_Tecnologia_Costa_Horas[Gas,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Uso Gas por Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Generacion_por_Tecnologia_Costa_Horas[Gas,Horas24], Uso_Gas_Total, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Wind Offshore Disponible Antes de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Energía_Series_viento_Total_Offshore*FC_Costa_Wind_Ajustado * (1 - Proporcion_Baterias_Offshore_a_Despachar)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Uso Wind Offshore por Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Gen Wind Offshore Disponible\nDespues de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(Energía_Series_viento_Total_Offshore*FC_Costa_Wind_Ajustado * (1 - Proporcion_Baterias_Offshore_a_Despachar) - Uso_Wind_Offshore_por_Carga_Bateria, 0)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Wind Onshore Disponible\nAntes de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Energía_Series_viento_Total_Onshore*FC_Costa_Wind_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Wind Onshore Disponible\nDespues de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Energía_Series_viento_Total_Onshore*FC_Costa_Wind_Ajustado - Consumo_Eolico_por_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Uso Wind Onshore\npor Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Horas Carga Baterias Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Horas Descarga Baterias Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
