			<aux name="Gen Pais\npor Tech Hora">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa_Horas *SW_Kill_of_Import_Hourly + Generacion_por_Tecnologia_Hora_Centro * SW_Kill_of_Import_Hourly + Otras_Fuentes_de_Gen_Pais_Por_Tec_Hora</eqn>
				<units>MWh</units>
			</aux>
			<group name="Distribucion Gen Pais" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Generacion_Total_Pais_por_Tecnologia"/>
				<entity name="SW_Kill_of_Import_Hourly"/>
				<entity name="Solar_DG_Battery_Pais_24h"/>
				<entity name="SW_Kill_of_Import"/>
				<entity name="Total_Faltantes_de_Energia"/>
				<entity name="Otras_Fuentes_de_Gen_Pais"/>
				<entity name="Emisiones_CO2_Eq_Pais_por_Teconologia"/>
				<entity name="Uso_Baterias_AutoGen_Costa"/>
				<entity name="Gen_Pais_por_Tech_Hora"/>
				<entity name='"%_Energia_Tecnologia"'/>
				<entity name="Solar_DG_Pais_24h"/>
				<entity name="Demanda_Vs_Generacion_por_Hora"/>
				<entity name="Emisiones_CO2_Eq_Costa_por_Teconologia"/>
				<entity name="Baterias_Distribuidas_Pais"/>
				<entity name="Generacion_Total_Costa"/>
				<entity name="Generacion_Total_Pais"/>
				<entity name="Generacion_Solar_Distribuida_Pais"/>
				<entity name="Total_Emisiones"/>
				<entity name="Gen_Pais_por_Hora"/>
				<entity name="Otras_Fuentes_de_Gen_Pais_Por_Tec_Hora"/>
				<entity name="Generacion_Total_Centro"/>
				<entity name="Emisiones_CO2_Eq_Centro_por_Teconologia"/>
			</group>
			<group name="Distribucion Gen Centro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Exportacion_Costa_a_Centro_Noche"/>
				<entity name="Generacion_Renovable_Noche"/>
				<entity name="Generacion_por_Tecnologia_Centro_Noche"/>
				<entity name="Generacion_por_Tecnologia_Hora_Centro_Noche"/>
				<entity name="Exportacion_Costa_a_Centro_noche_12h"/>
				<entity name="Exportacion_Costa_a_Centro_dia"/>
				<entity name="Generación_Importada_Costa_a_Centro"/>
				<entity name="Uso_Baterias_Solar_DG_Noche_Centro"/>
				<entity name="Uso_Baterias_Solar_DG_Dia_Centro"/>
				<entity name="Uso_Baterias_Solar_DG_Noche_Costa"/>
				<entity name="Generacion_Total_Centro_Noche"/>
				<entity name="Generacion_por_Tecnologia_Hora_Centro_Dia"/>
				<entity name="Solar_DG_Centro"/>
				<entity name="Generacion_por_Tecnologia_Centro_Dia"/>
				<entity name="Exportacion_Costa_a_Centro_dia_12h"/>
				<entity name="Energia_Eolica_Enviada"/>
			</group>
			<aux name="Gen Disp Hydro Embalse Con Reg">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Planta_Embalse_Regulacion *  Ajuste_Unidad_Gen_12_horas  * Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<group name="Despacho Gen Centro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Calculo_Precio_Electricidad_Centro_Dia"/>
				<entity name="Generacion_Centro_dia_ordenada"/>
				<entity name="Gen_vs_Dem"/>
				<entity name="Generacion_Disp_Centro_Dia_Ordenada"/>
				<entity name="Generacion_Tecnologias"/>
				<entity name="Solar_Panel_DG_Centro_24h"/>
				<entity name="Generacion_por_Tecnologia_Hora_Centro"/>
				<entity name="Generacion_Total_Centro_Dia"/>
				<entity name="Calculo_Gen_Centro_Dia"/>
				<entity name="Autogeneracion_Solar_Centro"/>
				<entity name="Aux_Gen_Dips_Centro_Dia"/>
				<entity name="Generacion_Solar_Distribuida_Centro"/>
				<entity name="Exportar_Energia_Centro_a_Costa_Dia"/>
				<entity name="Exportacion_Costa_a_Centro_Por_Horas"/>
				<entity name="Factor_de_carga_solar_día"/>
				<entity name="Precio_Electricidad"/>
				<entity name="Demanda_Merito_Centro_Horas"/>
			</group>
			<module name="Calculo Gen Centro Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Gen_Centro_Dia.Precio_Electricidad" from="Gen_Centro.Precio_Electricidad"/>
				<connect2 to="Calculo_Gen_Centro_Dia.Precio_Electricidad" from="Precio_Electricidad"/>
				<connect to="Calculo_Gen_Centro_Dia.Costo_para_Despacho_Ordenado" from="Gen_Centro.Costo_para_Despacho_Ordenado"/>
				<connect2 to="Calculo_Gen_Centro_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado"/>
				<connect to="Calculo_Gen_Centro_Dia.Generacion_Odernada" from="Gen_Centro.Generacion_Disp_Centro_Dia_Ordenada"/>
				<connect2 to="Calculo_Gen_Centro_Dia.Generacion_Odernada" from="Generacion_Disp_Centro_Dia_Ordenada"/>
				<connect to="Gen_Centro.Generacion_Tecnologias" from="Calculo_Gen_Centro_Dia.Generacion_Tecnologias"/>
				<connect2 to="Generacion_Tecnologias" from="Calculo_Gen_Centro_Dia.Generacion_Tecnologias"/>
				<connect to="Calculo_Gen_Centro_Dia.Demanda" from="Gen_Centro.Demanda_Merito_Centro_Horas"/>
				<connect2 to="Calculo_Gen_Centro_Dia.Demanda" from="Demanda_Merito_Centro_Horas"/>
			</module>
			<module name="Calculo Precio\nElectricidad Centro Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Precio_Electricidad_Centro_Dia.Generacion_Odernada" from="Gen_Centro.Generacion_Disp_Centro_Dia_Ordenada"/>
				<connect2 to="Calculo_Precio_Electricidad_Centro_Dia.Generacion_Odernada" from="Generacion_Disp_Centro_Dia_Ordenada"/>
				<connect to="Calculo_Precio_Electricidad_Centro_Dia.Costo_para_Despacho_Ordenado" from="Gen_Centro.Costo_para_Despacho_Ordenado"/>
				<connect2 to="Calculo_Precio_Electricidad_Centro_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado"/>
				<connect to="Gen_Centro.Precio_Electricidad" from="Calculo_Precio_Electricidad_Centro_Dia.Precio_Electricidad_Dia"/>
				<connect2 to="Precio_Electricidad" from="Calculo_Precio_Electricidad_Centro_Dia.Precio_Electricidad_Dia"/>
				<connect to="Calculo_Precio_Electricidad_Centro_Dia.Demanda" from="Gen_Centro.Demanda_Merito_Centro_Horas"/>
				<connect2 to="Calculo_Precio_Electricidad_Centro_Dia.Demanda" from="Demanda_Merito_Centro_Horas"/>
			</module>
			<stock name="Embalse Tipo2">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>{18000}
1700</eqn>
				<format precision="1"/>
				<inflow>Aportes_al_Emb_Tipo_2</inflow>
				<outflow>Generacion_de_Embalse_Tipo2</outflow>
				<outflow>Vertimiento_Tipo2</outflow>
				<non_negative/>
				<units>GWh</units>
			</stock>
			<flow name="Aportes al Emb Tipo 2">
				<eqn>Aportes_Centro_Embalses_sin_Regulacion/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Generacion de Embalse Tipo2">
				<eqn>IF(Embalse_Tipo2 -Despacho_Real_Embalse_Tipo_2_GWh+Aportes_al_Emb_Tipo_2*DT&lt;Minimo_Embalse_1)THEN
(Embalse_Tipo2-Minimo_Embalse_1)/DT
ELSE
Despacho_Real_Embalse_Tipo_2_GWh/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Maximo Embalse 1">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>1858+
IF(Año&gt;=2026)THEN
500
ELSE
0</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Minimo Embalse 1">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>876</eqn>
				<units>GWh</units>
			</aux>
			<flow name="Vertimiento Tipo2">
				<eqn>IF(Aportes_al_Emb_Tipo_2+Embalse_Tipo2/DT-Generacion_de_Embalse_Tipo2 &gt;= Maximo_Embalse_1/DT)THEN
Embalse_Tipo2/DT-Generacion_de_Embalse_Tipo2+Aportes_al_Emb_Tipo_2-Maximo_Embalse_1/DT
ELSE
0</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Aportes Centro Embalses\nsin Regulacion">
				<eqn>Aportes_Centro_Embalse * &quot;%_Aportes_sin_Regulacion&quot;</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Despacho Real Embalse Tipo 2 GWh">
				<eqn>SUM(Despacho_Real_Embalse_Tipo_2)  /Mwh_to_Gwh *30 /Eficiencia_HidroGeneración</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Aportes Centro Embalses\ncon Regulacion">
				<eqn>Aportes_Centro_Embalse * &quot;%_Aportes_con_Regulacion&quot;</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="% Aportes con Regulacion">
				<eqn>0.49</eqn>
				<units>unitless</units>
			</aux>
			<aux name="% Aportes sin Regulacion">
				<eqn>0.30</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Embalse Tipo2">
				<eqn>(Embalse_Tipo2+Aportes_Centro_Embalses_sin_Regulacion - Minimo_Embalse_1)*Mwh_to_Gwh</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Hydro Filo de Agua">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Centro[Run_of_the_River] *  Ajuste_Unidad_Gen_12_horas  * FC_Hydro_Runof_River</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Hydro Embalse sin Reg">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Planta_Embalse_Tipo2*  Ajuste_Unidad_Gen_12_horas  * Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Aportes Filo de Agua dia">
				<eqn>Aportes_Centro_Filo_de_Agua/30/24*Mwh_to_Gwh/DT</eqn>
				<units>MWh/Months</units>
			</aux>
			<stock name="Embalse Penol">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>4000</eqn>
				<inflow>Aportes_al_Penol</inflow>
				<outflow>Generacion_de_Embalse_Penol</outflow>
				<outflow>Vertimiento_Penol</outflow>
				<non_negative/>
				<units>GWh</units>
			</stock>
			<flow name="Aportes al Penol">
				<eqn>Aportes_Penol/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Generacion de Embalse Penol">
				<eqn>IF(Embalse_Penol-Despacho_Real_Penol_GWh+Aportes_al_Penol*DT&lt;Minimo_Embalse_Penol)THEN
(Embalse_Penol-Minimo_Embalse_Penol)/DT
ELSE
Despacho_Real_Penol_GWh/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Vertimiento Penol">
				<eqn>IF(Aportes_al_Penol+Embalse_Penol/DT-Generacion_de_Embalse_Penol &gt;= Maximo_Embalse_Penol/DT)THEN
Embalse_Penol/DT-Generacion_de_Embalse_Penol+Aportes_al_Penol-Maximo_Embalse_Penol/DT
ELSE
0</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Maximo Embalse Penol">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>4428</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Minimo Embalse Penol">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>307.76</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Despacho Real Penol GWh">
				<eqn>SUM(Despacho_Real_Embalse_Penol)  /Mwh_to_Gwh * 30/Eficiencia_HidroGeneración</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="%Aportes Penol">
				<eqn>0.06</eqn>
				<units>unitless</units>
			</aux>
			<aux name="%Aportes Bogota">
				<eqn>0.1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Aportes Penol">
				<eqn>&quot;%Aportes_Penol&quot; * Aportes_Centro_Embalse</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Aportes Bogota">
				<eqn>&quot;%Aportes_Bogota&quot; * Aportes_Centro_Embalse</eqn>
				<units>Gwh</units>
			</aux>
			<stock name="Embalse Bogota">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>5000</eqn>
				<inflow>Aportes_al_Bogota</inflow>
				<outflow>Generacion_de_Embalse_Bogota</outflow>
				<outflow>Otros_Usos</outflow>
				<outflow>Vertimiento_Bogota</outflow>
				<non_negative/>
				<units>GWh</units>
			</stock>
			<flow name="Aportes al Bogota">
				<eqn>Aportes_Bogota/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Generacion de Embalse Bogota">
				<eqn>IF(Embalse_Bogota-Despacho_Real_Bogota_GWh+Aportes_al_Bogota*DT&lt;Minimo_Embalse_Bogota)THEN
(Embalse_Bogota-Minimo_Embalse_Bogota)/DT
ELSE
Despacho_Real_Bogota_GWh/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Vertimiento Bogota">
				<eqn>IF(Aportes_al_Bogota+Embalse_Bogota/DT-Generacion_de_Embalse_Bogota &gt;= Maximo_Embalse_Bogota/DT)THEN
Embalse_Bogota/DT-Generacion_de_Embalse_Bogota+Aportes_al_Bogota-Maximo_Embalse_Bogota/DT
ELSE
0</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Maximo Embalse Bogota">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>5005</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Minimo Embalse Bogota">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>44.97</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Despacho Real Bogota GWh">
				<eqn>SUM(Despacho_Real_Embalse_Bogota)  /Mwh_to_Gwh * 30/Eficiencia_HidroGeneración</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Capacidad Planta Bogota" access="input">
				<eqn>560</eqn>
				<units>MW</units>
			</aux>
			<aux name="Potencia Efectiva Bogota">
				<eqn>MIN(Gen_Embalse_Bogota, Gen_Disp_Embalse_Bogota_Mes)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Bogota">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Planta_Bogota *  Ajuste_Unidad_Gen_12_horas  * Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<flow name="Otros Usos">
				<eqn>Embalse_Bogota * 0.2 / DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Gen Embalse Bogota">
				<eqn>(Embalse_Bogota - Minimo_Embalse_Bogota)*Mwh_to_Gwh</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Bogota Mes">
				<eqn>SUM(Gen_Disp_Embalse_Bogota) * 30</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Real Bogota">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Efectiva_Bogota/30/24 * Eficiencia_HidroGeneración</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Embalse Punchina">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>50</eqn>
				<inflow>Generacion_de_Embalse_Penol</inflow>
				<inflow>Aportes_Punchina</inflow>
				<outflow>Generacion_de_Embalse_Punchina</outflow>
				<outflow>Vertimiento_Punchina</outflow>
				<non_negative/>
				<units>GWh</units>
			</stock>
			<flow name="Generacion de Embalse Punchina">
				<eqn>IF( Embalse_Punchina/DT-Despacho_Real_Punchina_GWh/DT + Aportes_Punchina + Generacion_de_Embalse_Penol &lt;Minimo_Embalse_Punchina /DT)THEN
(Embalse_Punchina-Minimo_Embalse_Punchina)/DT
ELSE
Despacho_Real_Punchina_GWh/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Maximo Embalse Punchina">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>86.25</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Minimo Embalse Punchina">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>20.76</eqn>
				<units>GWh</units>
			</aux>
			<flow name="Vertimiento Punchina">
				<eqn>IF(Aportes_Punchina+Generacion_de_Embalse_Penol+Embalse_Punchina/DT-Generacion_de_Embalse_Punchina &gt;= Maximo_Embalse_Punchina/DT)THEN
Embalse_Punchina/DT-Generacion_de_Embalse_Punchina+Aportes_Punchina+Generacion_de_Embalse_Penol-Maximo_Embalse_Punchina/DT
ELSE
0</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Aportes Punchina">
				<eqn>Aportes_San_Carlos/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="%Aportes San Carlos">
				<eqn>0.06</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Aportes San Carlos">
				<eqn>&quot;%Aportes_San_Carlos&quot; * Aportes_Centro_Embalse</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Despacho Real Punchina GWh">
				<eqn>SUM(Despacho_Real_Embalse_Punchina)  /Mwh_to_Gwh * 30/Eficiencia_HidroGeneración</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Capacidad Planta Penol" access="input">
				<eqn>560</eqn>
				<units>MW</units>
			</aux>
			<aux name="Capacidad Planta Punchina" access="input">
				<eqn>1240</eqn>
				<units>MW</units>
			</aux>
			<aux name="Gen Disp Embalse Penol">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Planta_Penol *  Ajuste_Unidad_Gen_12_horas  * Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Punchina">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Planta_Punchina *  Ajuste_Unidad_Gen_12_horas  * Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Punchina Mes">
				<eqn>SUM(Gen_Disp_Embalse_Punchina) * 30</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Penol Mes">
				<eqn>SUM(Gen_Disp_Embalse_Penol) * 30</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Embalse Penol">
				<eqn>(Embalse_Penol +Aportes_al_Penol*DT- Minimo_Embalse_Penol)*Mwh_to_Gwh</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Efectiva Penol">
				<eqn>MIN(Gen_Embalse_Penol, Gen_Disp_Embalse_Penol_Mes)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Real Penol">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Efectiva_Penol/30/24 * Eficiencia_HidroGeneración</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Embalse Punchina">
				<eqn>(Embalse_Punchina+Aportes_San_Carlos+Aportes_al_Penol * DT - Minimo_Embalse_Punchina )*Mwh_to_Gwh</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Efectiva Punchina">
				<eqn>MIN(Gen_Embalse_Punchina, Gen_Disp_Embalse_Punchina_Mes)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Real Punchina">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Efectiva_Punchina/30/24 * Eficiencia_HidroGeneración</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Planta Embalse Regulacion" access="input">
				<eqn>4955</eqn>
				<units>MW</units>
			</aux>
			<aux name="Gen Embalse Tipo1">
				<eqn>(Embalse_Tipo1+Aportes_Centro_Embalses_con_Regulacion - Minimo_Embalse)*Mwh_to_Gwh</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Efectiva Tipo1">
				<eqn>MIN(Gen_Embalse_Tipo1, Gen_Disp_Embalse_Tipo1_Mes)</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Real Tipo1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Efectiva_Tipo1/30/24 * Eficiencia_HidroGeneración</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Tipo1 Mes">
				<eqn>SUM(Gen_Disp_Hydro_Embalse_Con_Reg) * 30</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Planta\nEmbalse Tipo2" access="input">
				<eqn>4955</eqn>
				<units>MW</units>
			</aux>
			<aux name="Potencia Efectiva Tipo 2">
				<eqn>MIN(Gen_Embalse_Tipo2, Gen_Disp_Embalse_Tipo2_Mes)</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Real Tipo 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Efectiva_Tipo_2/(30*24) * Eficiencia_HidroGeneración</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Tipo2 Mes">
				<eqn>SUM(Gen_Disp_Hydro_Embalse_sin_Reg) * 30</eqn>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Check Pesos">
				<eqn>&quot;%Aportes_Bogota&quot; + &quot;%Aportes_Penol&quot; + &quot;%Aportes_San_Carlos&quot; + &quot;%_Aportes_con_Regulacion&quot; + &quot;%_Aportes_sin_Regulacion&quot;</eqn>
				<isee:summing/>
				<units>unitless</units>
			</aux>
			<aux name="Suma Embalses Centro">
				<eqn>Embalse_Bogota + Embalse_Penol + Embalse_Punchina + Embalse_Tipo1 + Embalse_Tipo2</eqn>
				<isee:summing/>
				<units>Gwh</units>
			</aux>
			<group name="Simulacion de Embalses" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Maximo_Embalse_1"/>
				<entity name="Aportes_al_Emb_Tipo1"/>
				<entity name="Aportes_Filo_de_Agua_dia"/>
				<entity name="Gen_Disp_Embalse_Tipo1_Mes"/>
				<entity name="Potencia_Efectiva_Tipo1"/>
				<entity name="Minimo_Embalse_Penol"/>
				<entity name='"%_Aportes_Centro"'/>
				<entity name="Unidad_MWh_GWh"/>
				<entity name="Suma_Vertimientos_Centro"/>
				<entity name="Aportes_Centro"/>
				<entity name="Despacho_Real_Embalse_Tipo_2"/>
				<entity name="Gen_Disp_Embalse_Bogota"/>
				<entity name="Potencia_Real_Penol"/>
				<entity name="Aportes_San_Carlos"/>
				<entity name="Gen_Embalse_Tipo1"/>
				<entity name="Potencia_Efectiva_Penol"/>
				<entity name="Maximo_Embalse_Penol"/>
				<entity name="Aportes_al_Emb_Tipo_2"/>
				<entity name="Embalse_Penol"/>
				<entity name="Potencia_Efectiva_Tipo_2"/>
				<entity name="Generacion_de_Embalse_Penol"/>
				<entity name="Gen_Disp_Embalse_Bogota_Mes"/>
				<entity name="Potencia_Real_Punchina"/>
				<entity name="Factor_de_Carga_Filo_Ajustada"/>
				<entity name="Despacho_Real_Embalse_Bogota"/>
				<entity name="Generacion_de_Embalse_Tipo1"/>
				<entity name="Gen_Disp_Embalse_Punchina_Mes"/>
				<entity name="Aportes_Punchina"/>
				<entity name="Despacho_Real_Penol_GWh"/>
				<entity name="Aportes_Centro_Embalse"/>
				<entity name="Gen_Embalse_Penol"/>
				<entity name='"%Aportes_San_Carlos"'/>
				<entity name="Aportes_Penol"/>
				<entity name="Aportes_Centro_Embalses_sin_Regulacion"/>
				<entity name="Potencia_Real_Tipo1"/>
				<entity name="Vertimiento_Penol"/>
				<entity name="Suma_Embalses_Centro"/>
				<entity name="Suma_Embalses_Penol_San_Carlos"/>
				<entity name="Suma_Vertimiento_Penol_San_Carlos"/>
				<entity name="Participacin_Punchina"/>
				<entity name="Vertimiento_Punchina"/>
				<entity name="Minimo_Embalse_Punchina"/>
				<entity name="Vertimiento_Tipo2"/>
				<entity name='"%Aportes_Penol"'/>
				<entity name="Total_Vertimientos_Hydro_GWh"/>
				<entity name="Gen_Embalse_Punchina"/>
				<entity name="Generacion_Hidro_Restante_Post_Emb_Punchina"/>
				<entity name="Capacidad_Descarga_Bombeo"/>
				<entity name="Gen_Disp_Embalse_Penol_Mes"/>
				<entity name="Aportes_Init_HidroItuango"/>
				<entity name="Despacho_Real_Emb_Tipo1_GWh"/>
				<entity name="Aportes_HidroItuango"/>
				<entity name="Variación_Aportes"/>
				<entity name="Otros_Usos"/>
				<entity name="Aportes_al_Bogota"/>
				<entity name="Maximo_Embalse"/>
				<entity name="Capacidad_Carga_Bombeo"/>
				<entity name="Embalse_Tipo1"/>
				<entity name="Potencia_Efectiva_Punchina"/>
				<entity name="Gen_Embalse_Bogota"/>
				<entity name="Aportes_Bogota"/>
				<entity name="Aportes_Sensibilidad"/>
				<entity name="Generacion_Hidro_Restante_Post_Emb_Bogota"/>
				<entity name="Potencia_Real_Bogota"/>
				<entity name="Gen_Disp_Hydro_Embalse_Con_Reg"/>
				<entity name="Exportacion_Hidro_Centro_a_Costa_Noche"/>
				<entity name="Gen_Disp_Embalse_Penol"/>
				<entity name='"%_Aportes_sin_Regulacion"'/>
				<entity name="Vertimiento_Tipo1"/>
				<entity name="Despacho_Real_Embalse_Penol"/>
				<entity name="Mwh_to_Gwh"/>
				<entity name="Minimo_Embalse_1"/>
				<entity name="Despacho_Real_Bogota_GWh"/>
				<entity name="Eficiencia_HidroGeneración"/>
				<entity name="FC_Hydro_Embalse"/>
				<entity name="Generacion_Hidro_Disponible_hora"/>
				<entity name="Factor_de_Carga_Hidro_Ajustado"/>
				<entity name="Maximo_Embalse_Punchina"/>
				<entity name="Inc_Capacidad_Filo_de_Agua"/>
				<entity name="Despacho_Real_Punchina_GWh"/>
				<entity name='"Rel_Aportes_Centro_-_Costa"'/>
				<entity name="Embalse_Tipo2"/>
				<entity name="Vol_Efectivo"/>
				<entity name="Despacho_Real_Embalse_Tipo_2_GWh"/>
				<entity name="Vertimiento_Bogota"/>
				<entity name="Minimo_Embalse_Bogota"/>
				<entity name="Generacion_de_Embalse_Tipo2"/>
				<entity name="Total_Vertimientos_Hydro_Mwh"/>
				<entity name="Suma_Aportes_Penol_San_Carlos"/>
				<entity name="Generacion_Hidro_Disponible_Dia_24h"/>
				<entity name="Minimo_Embalse"/>
				<entity name="Despacho_Real_Embalse_Punchina"/>
				<entity name="Gen_Disp_Embalse_Tipo2_Mes"/>
				<entity name="Gen_Embalse_Tipo2"/>
				<entity name="Generacion_de_Embalse_Punchina"/>
				<entity name="Despacho_Real_Embalse_Tipo_1"/>
				<entity name="Gen_Disp_Embalse_Punchina"/>
				<entity name="Generacion_Filo_de_Agua"/>
				<entity name="Aportes_al_Penol"/>
				<entity name="Aportes_Centro_Embalses_con_Regulacion"/>
				<entity name="Despacho_Real_Penol_Punchina_GWh"/>
				<entity name="Potencia_Efectiva_Bogota"/>
				<entity name="Aportes_Hidro_Ituango_2"/>
				<entity name="Capacidad_Planta_Embalse_Tipo2"/>
				<entity name="Check_Pesos"/>
				<entity name="Generacion_Hidro_Restante_Post_Emb_Tipo_2"/>
				<entity name='"%Aportes_Bogota"'/>
				<entity name="Generacion_de_Embalse_Bogota"/>
				<entity name="Maximo_Embalse_Bogota"/>
				<entity name="Potencia_Real_Tipo_2"/>
				<entity name="Gen_Disp_Hydro_Filo_de_Agua"/>
				<entity name="Generacion_Hidro_Restante_Post_Emb_Tipo_1"/>
				<entity name="Aportes_Centro_Filo_de_Agua"/>
				<entity name="Gen_Disp_Hydro_Embalse_sin_Reg"/>
				<entity name="Embalse_Punchina"/>
				<entity name="Embalse_Bogota"/>
				<entity name='"%_Aportes_con_Regulacion"'/>
			</group>
			<aux name="Despacho Real Embalse Tipo 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Potencia_Real_Tipo_2, Generacion_por_Tecnologia_Hora_Centro[Hydro,Horas24] + Exportacion_Hidro_Centro_a_Costa_Noche)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Participacin Punchina">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Potencia_Real_Punchina/Vol_Efectivo</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Hidro Restante Post Emb Tipo 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro[Hydro,Horas24] + Exportacion_Hidro_Centro_a_Costa_Noche - 
Despacho_Real_Embalse_Tipo_2</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Despacho Real Embalse Tipo 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Potencia_Real_Tipo1, Generacion_Hidro_Restante_Post_Emb_Tipo_2 )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Hidro\nRestante Post Emb Tipo 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Hidro_Restante_Post_Emb_Tipo_2 - 
Despacho_Real_Embalse_Tipo_1</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Despacho Real Embalse Bogota">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Potencia_Real_Bogota, Generacion_Hidro_Restante_Post_Emb_Tipo_1 )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Despacho Real Embalse Punchina">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Potencia_Real_Punchina, Generacion_Hidro_Restante_Post_Emb_Bogota )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Hidro\nRestante Post Emb Bogota">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Hidro_Restante_Post_Emb_Tipo_1 - 
Despacho_Real_Embalse_Bogota</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Hidro\nRestante Post Emb Punchina">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Hidro_Restante_Post_Emb_Bogota - 
Despacho_Real_Embalse_Punchina</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Despacho Real Embalse Penol">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Potencia_Real_Penol,  Generacion_Hidro_Restante_Post_Emb_Punchina )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Despacho Real Penol Punchina GWh">
				<eqn>Despacho_Real_Penol_GWh + Despacho_Real_Punchina_GWh</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Suma Vertimientos Centro">
				<eqn>Vertimiento_Tipo2 + Vertimiento_Tipo1 + Vertimiento_Bogota + Vertimiento_Penol + Vertimiento_Punchina</eqn>
				<isee:summing/>
				<units>GWh/Months</units>
			</aux>
			<aux name="Suma Embalses Penol San Carlos">
				<eqn>Embalse_Penol + Embalse_Punchina</eqn>
				<isee:summing/>
				<units>Gwh</units>
			</aux>
			<aux name="Suma Vertimiento\nPenol San Carlos">
				<eqn>Vertimiento_Penol + Vertimiento_Punchina</eqn>
				<isee:summing/>
				<units>GWh/Months</units>
			</aux>
			<aux name="Suma Aportes\nPenol San Carlos">
				<eqn>Aportes_Penol + Aportes_San_Carlos</eqn>
				<isee:summing/>
				<units>Gwh</units>
			</aux>
			<aux name="Eficiencia Batería" access="input">
				<eqn>0.95</eqn>
				<units>unitless</units>
			</aux>
			<group name="Calculo Solar Baterias Centro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Disponible_Baterias_Distribuidas_Centros"/>
				<entity name="Carga_Baterias_Distribuidas_Centro"/>
				<entity name="Consumo_Solar_Por_Carga_de_Bateria"/>
				<entity name="Consumo_de_Solar_DG_por_Carga_baterias"/>
				<entity name="Carga_Baterias_Centro"/>
				<entity name="Cap_Baterias_Centro"/>
				<entity name="Eficiencia_Batería_1"/>
				<entity name="Gen_Centro_Disp_Solar"/>
				<entity name="Autogeneracion_Solar_Disponible_Antes_de_Bateria"/>
				<entity name="Horas_Carga_Descarga_Baterias"/>
				<entity name="Cap_Baterias_Distribuidas_Centro"/>
				<entity name="Uso_Baterias_AutoGen_Centro"/>
				<entity name="Disponible_Bateria_Centro"/>
				<entity name="Factor_de_Carga_Solar_Ajustado"/>
				<entity name="Gen_Centro_Disp_Bateria_MEtodologia_1"/>
				<entity name="Horas_Descarga_Baterias"/>
				<entity name="Cap_instalada_Solar_DG_Centro"/>
				<entity name="Paneles_Centro_Ajustado"/>
				<entity name="Gen_Centro_Disp_antes_de_Baterias"/>
				<entity name="Gen_Centro_Disp_Baterias"/>
				<entity name="Baterías_Instaladas"/>
			</group>
			<aux name="Gen Centro Disp Solar">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX( 0 ,  (Capacidad_Instalada_Centro[Solar])*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado * To_MWh -Consumo_Solar_Por_Carga_de_Bateria )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Centro Disp Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Disponible_Bateria_Centro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Horas Carga Descarga Baterias" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Horas Descarga Baterias" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="To MWh">
				<eqn>1</eqn>
				<units>MWh/(MW*hr)</units>
			</aux>
			<aux name="Exportacion Hidro\nCentro a Costa Noche" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Horas de Bombeo" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Horas descarga Carga Bombeo" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Capacidad Carga Bombeo">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Centro[Pump] * Horas_de_Bombeo * 30 * Ajuste_Unidad_Gen_12_horas / Mwh_to_Gwh</eqn>
				<units>Gwh</units>
			</aux>
			<aux name="Capacidad Descarga Bombeo">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Centro[Pump] * Horas_descarga_Carga_Bombeo * 30 * Ajuste_Unidad_Gen_12_horas / Mwh_to_Gwh</eqn>
				<units>Gwh</units>
			</aux>
			<stock name="Baterías Instaladas" access="input">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MWh</units>
			</stock>
			<aux name="Paneles Centro Ajustado">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Cap_instalada_Solar_DG_Centro</eqn>
				<units>MW</units>
			</aux>
			<aux name="Uso Baterias AutoGen Centro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Baterías_Instaladas[Centro] * Eficiencia_Batería * Horas_Descarga_Baterias*0 + 
Disponible_Baterias_Distribuidas_Centros, 
Demanda_Centro_24h)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Energia Disponible desde Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Importacion Solar de la Costa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Exportacion_Solar_Costa_a_Centro_Dia</eqn>
				<units>MWh</units>
			</aux>
