			</aux>
			<aux name="Carga Final del dia">
				<eqn>Bateria_O_H_23*Eficiencia_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Descarga Bateria por Hora">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Carga_Final_del_dia*Proporcion_Ajustada</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Total Horas Descarga">
				<eqn>SUM(Horas_Descarga)</eqn>
				<units>unitless</units>
			</aux>
