   IF (Suma_0&lt;Oferta)THEN
      Costo_para_Despacho_Ordenado[1]
   ELSE
      0
ELSE
   0</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
