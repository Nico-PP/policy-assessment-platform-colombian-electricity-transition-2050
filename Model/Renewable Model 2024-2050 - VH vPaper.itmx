			</aux>
			<aux name="Distribucion Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Distribucion_Horas_1, Suma_Distribucion, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Tec2 Onshore previo">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Gen_Tec_2, Excedentes_Energia_Costa_Horas -Gen_Tec1_Disp_para_Carga_Previo) * Hora_Carga_Bateria_Tec_2 * 
Factor_de_Recarga_de_Bateria_Tec_2</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria W H 0">
