Capacidad_instalada_costa_Ajustada[Element_16]</eqn>
				</element>
				<element subscript="Element_17, Centro">
					<eqn>Capacidad_en_construccion_centro[Element_17] +
Capacidad_instalada_centro_Ajustada[Element_17]</eqn>
				</element>
				<element subscript="Element_17, Costa">
					<eqn>Capacidad_en_construccion_costa[Element_17] + 
Capacidad_instalada_costa_Ajustada[Element_17]</eqn>
				</element>
				<element subscript="Wind_Offshore2, Centro">
					<eqn>Capacidad_en_construccion_centro[Wind_Offshore2] +
Capacidad_instalada_centro_Ajustada[Wind_Offshore2]</eqn>
				</element>
				<element subscript="Wind_Offshore2, Costa">
					<eqn>Capacidad_en_construccion_costa[Wind_Offshore2] + 
Capacidad_instalada_costa_Ajustada[Wind_Offshore2]</eqn>
				</element>
				<units>MW</units>
			</aux>
			<aux name="Factor de Disponibilidad">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
					<eqn>0.85
{0.85}</eqn>
				</element>
				<element subscript="Oil">
					<eqn>0.9
{0.9}</eqn>
				</element>
				<element subscript="Coal">
					<eqn>0.7
{0.7}</eqn>
				</element>
				<element subscript="Others">
					<eqn>0.3
{0.3}</eqn>
				</element>
				<element subscript="Wind">
					<eqn>0.39
{0.39}</eqn>
				</element>
				<element subscript="Hydro">
					<eqn>0.5
{0.50}</eqn>
				</element>
				<element subscript="Solar">
					<eqn>0.239583
{0.2395833333333}</eqn>
				</element>
				<element subscript="Run_of_the_River">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Hydrogen">
					<eqn>1</eqn>
				</element>
				<element subscript="Wind_Offshore">
					<eqn>1</eqn>
				</element>
				<element subscript="Battery">
					<eqn>5/24</eqn>
				</element>
				<element subscript="Pump">
					<eqn>1</eqn>
				</element>
				<element subscript="Geothermal">
					<eqn>1</eqn>
				</element>
				<element subscript="Biomass">
					<eqn>1</eqn>
				</element>
				<element subscript="Element_15">
					<eqn>1</eqn>
				</element>
				<element subscript="Element_16">
					<eqn>1</eqn>
				</element>
				<element subscript="Element_17">
					<eqn>1</eqn>
				</element>
				<element subscript="Wind_Offshore2">
					<eqn>5/24</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Gas, Centro">
					<eqn>Capacidad_Futura[Gas,Centro] * Factor_de_Disponibilidad[Gas]*
&quot;Ajuste_Unidad_Mwh/Mw&quot;</eqn>
				</element>
				<element subscript="Gas, Costa">
					<eqn>Capacidad_Futura[Gas,Costa] * Factor_de_Disponibilidad[Gas]*
&quot;Ajuste_Unidad_Mwh/Mw&quot;</eqn>
				</element>
