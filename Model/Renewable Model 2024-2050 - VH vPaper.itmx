	<model name="Carga_Baterias_Centro">
		<variables>
			<aux name="Gen Solar Disp para Carga">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Converter_2,  Energia_Excedente) * 
Factor_de_Recarga_de_Bateria * 
Hora_Carga_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 0">
				<eqn>MIN(Gen_Solar_Disp_para_Carga[H0],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Bateria Mwh">
				<eqn>&quot;Cap_Bateria_MWh_-_Input&quot;</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Dummy Hora Carga Bateria">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Hora_Carga_Bateria</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Bateria H 1">
				<eqn>MIN(Bateria_H_0 + Gen_Solar_Disp_para_Carga[H1],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 2">
				<eqn>MIN(Bateria_H_1 + Gen_Solar_Disp_para_Carga[H2] ,  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 3">
				<eqn>MIN(Bateria_H_2 + Gen_Solar_Disp_para_Carga[H3],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 4">
				<eqn>MIN(Bateria_H_3 + Gen_Solar_Disp_para_Carga[H4] ,  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 5">
				<eqn>MIN(Bateria_H_4 + Gen_Solar_Disp_para_Carga[H5],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 6">
				<eqn>MIN(Bateria_H_5 + Gen_Solar_Disp_para_Carga[H6],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 7">
				<eqn>MIN(Bateria_H_6 + Gen_Solar_Disp_para_Carga[H7],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 8">
				<eqn>MIN(Bateria_H_7 + Gen_Solar_Disp_para_Carga[H8],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 9">
				<eqn>MIN(Bateria_H_8 + Gen_Solar_Disp_para_Carga[H9],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 10">
				<eqn>MIN(Bateria_H_9 + Gen_Solar_Disp_para_Carga[H10] ,  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
