			</aux>
			<aux name="Capacidad Molino Offshore">
				<eqn>10</eqn>
				<units>MW</units>
			</aux>
			<aux name="Potencia por Metro Cuadrado Offshore">
				<eqn>(1/2) * Ajuste_Unidad_Energia*((Converter_19)^3)*Area_Molino_Offshore*To_Watts</eqn>
				<units>Watts</units>
			</aux>
			<aux name="Tamaño Hoja Offshore">
				<eqn>60</eqn>
				<units>Meters</units>
			</aux>
			<aux name="Area Molino Offshore">
				<eqn>PI * (Tamaño_Hoja_Offshore ^2)</eqn>
				<units>Square Meters</units>
			</aux>
			<aux name="Potencia Offshore">
				<eqn>Potencia_por_Metro_Cuadrado_Offshore/To_MW</eqn>
				<units>MW</units>
			</aux>
			<aux name="Converter 19">
				<eqn>Serie_Velocidad_Viento_1*1.2</eqn>
				<units>Meters Per Second</units>
			</aux>
			<aux name="To Joules">
				<eqn>1</eqn>
				<units>(kg * Square Meters / Seconds^2 )/ joule</units>
			</aux>
			<aux name="Potencia Viento Offshore" access="output">
				<eqn>Potencia_Offshore*Eficiencia_Velocidad_Offshore</eqn>
				<units>MW</units>
			</aux>
			<aux name="Eficiencia Velocidad Offshore">
				<eqn>0.6</eqn>
				<units>unitless</units>
			</aux>
