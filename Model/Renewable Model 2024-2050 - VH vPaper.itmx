				<element subscript="15">
					<eqn>LCOE_Tecnologia_Despacho[Hydro] + 0.0001

{el adicional es para evitar que sea exactamente igual al hydro de la región dado a que el modelo no sabe tomar decisiones entre mismos precios}</eqn>
				</element>
				<element subscript="16">
					<eqn>LCOE_Tecnologia_Despacho[Wind] -0.001</eqn>
				</element>
				<element subscript="17">
					<eqn>LCOE_Tecnologia_Despacho[Element_17]</eqn>
				</element>
				<element subscript="18">
					<eqn>LCOE_Tecnologia_Despacho[Wind]-0.0001</eqn>
				</element>
				<units>USD/kWh</units>
			</aux>
