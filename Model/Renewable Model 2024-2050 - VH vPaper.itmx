	<model name="Calculo_Previo_Precio_Electricidad_Centro_Dia">
		<variables>
			<aux name="Generacion Odernada" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Costo para Despacho Ordenado" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>USD/kWh</units>
			</aux>
			<aux name="Oferta">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Suma 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Oferta&gt;0)THEN
   IF (Suma_0&lt;Oferta)THEN
      Suma_0 +Generacion_Odernada[1,Horas24]
   ELSE
      Suma_0
ELSE
   0</eqn>
				<format precision="0.0001"/>
				<units>MWh</units>
			</aux>
			<aux name="Suma 0">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
