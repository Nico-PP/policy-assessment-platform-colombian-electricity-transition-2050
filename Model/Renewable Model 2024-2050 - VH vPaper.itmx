			<aux name="LCOE Tecnologia Despacho">
				<doc>Fuente de algunos datos:
Renovables:
https://mc-cd8320d4-36a1-40ac-83cc-3389-cdn-endpoint.azureedge.net/-/media/Files/IRENA/Agency/Publication/2023/Aug/IRENA_Renewable_power_generation_costs_in_2022.pdf?rev=cccb713bf8294cc5bec3f870e1fa15c2


Termicas
https://www.researchgate.net/figure/LCOE-of-different-types-of-power-plant_tbl1_357354732</doc>
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
					<eqn>LCOE_por_Tecnologia_TS[Gas]</eqn>
				</element>
				<element subscript="Oil">
					<eqn>LCOE_por_Tecnologia_TS[Oil]</eqn>
				</element>
				<element subscript="Coal">
					<eqn>LCOE_por_Tecnologia_TS[Coal]</eqn>
				</element>
				<element subscript="Others">
					<eqn>LCOE_por_Tecnologia_TS[Others]</eqn>
				</element>
				<element subscript="Wind">
					<eqn>LCOE_por_Tecnologia_TS[Wind]</eqn>
				</element>
				<element subscript="Hydro">
					<eqn>{  0,042 * 0 }
LCOE_Hydro_Ponderado</eqn>
				</element>
				<element subscript="Solar">
					<eqn>{  0,024*0  + 0,4597 * EXP(-0,249 * X) } 
LCOE_por_Tecnologia_TS[Solar]</eqn>
				</element>
				<element subscript="Run_of_the_River">
					<eqn>{0,041*0 + 0,03}
LCOE_por_Tecnologia_TS[Run_of_the_River]</eqn>
				</element>
				<element subscript="Hydrogen">
					<eqn>9999999999999999</eqn>
				</element>
				<element subscript="Wind_Offshore">
					<eqn>{0,0225 + 0,2107*EXP(-0,104 * X)}
LCOE_por_Tecnologia_TS[Wind_Offshore]</eqn>
				</element>
				<element subscript="Battery">
					<eqn>{0,035151781
+ 1,262 * EXP(-0,24 * X)}
LCOE_por_Tecnologia_TS[Battery]</eqn>
				</element>
				<element subscript="Pump">
					<eqn>9999999999999999</eqn>
				</element>
				<element subscript="Geothermal">
					<eqn>LCOE_por_Tecnologia_TS[Geothermal]</eqn>
				</element>
				<element subscript="Biomass">
					<eqn>LCOE_por_Tecnologia_TS[Biomass]</eqn>
				</element>
				<element subscript="Element_15">
					<eqn>9999999999999999</eqn>
				</element>
				<element subscript="Element_16">
					<eqn>9999999999999999</eqn>
				</element>
				<element subscript="Element_17">
					<eqn>9999999999999999</eqn>
				</element>
				<element subscript="Wind_Offshore2">
					<eqn>LCOE_por_Tecnologia_TS[Gas]-0.00001</eqn>
				</element>
				<units>USD/KWh</units>
			</aux>
