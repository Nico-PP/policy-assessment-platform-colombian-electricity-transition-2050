			</aux>
			<aux name="Uso Baterias Solar DG Noche Costa" access="output">
				<eqn>SUM(Uso_Baterias_AutoGen_Costa * Factor_Noche)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Uso Baterias Solar\nDG Dia Costa">
				<eqn>SUM(Uso_Baterias_AutoGen_Costa * Factor_Dia)</eqn>
				<units>MWh</units>
			</aux>
			<group name="Calculo Baterias Solar Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Cap_Baterias_2"/>
				<entity name="Excedentes"/>
				<entity name="Consumo_Solar_por_Bateria"/>
				<entity name="Dispotnibilidad_Tec_1_Bat2"/>
				<entity name="Gen_Solar_Distribuidad_Disponible_Antes_de_Baterias"/>
				<entity name="Baterias_Distribuidas_Costa"/>
				<entity name="Gen_Wind_Offshore_Disponible_Despues_de_Baterias"/>
				<entity name="Gen_Wind_Offshore_Disponible_Antes_de_Baterias"/>
				<entity name="Gen_Wind_Onshore_Disponible_Despues_de_Baterias"/>
				<entity name="Carga_Baterias_Costa"/>
				<entity name="Gen_Disponible_Solar_2"/>
				<entity name="Gen_Disponible_Solar_antes_de_Baterias"/>
				<entity name="Uso_Tec1_por_Carga_Bateria"/>
				<entity name="Capacidad_Instalada_Baterias_Costa"/>
				<entity name="Carga_Baterias_Costa_1"/>
				<entity name="Converter_7"/>
				<entity name="Disponibilidad_Tec_1"/>
				<entity name="Gen_Wind_Onshore_Disponible_Antes_de_Baterias"/>
				<entity name="Horas_Carga_Baterias_Opt_2"/>
				<entity name="Uso_Wind_Offshore_por_Carga_Bateria"/>
				<entity name="Converter_5"/>
				<entity name="Cap_instalada_Solar_DG_costa"/>
				<entity name="Gen_Disponible_Solar_despues_de_baterias"/>
				<entity name="Consumo_Eolico_por_Bateria"/>
				<entity name="Cap_Baterias_Costa"/>
				<entity name="Cargar_Baterias_con_Solar"/>
				<entity name="Uso_Wind_Onshore_por_Carga_Bateria"/>
				<entity name="Capacidad_Eolico_Offshore_2"/>
				<entity name="Proporcion_Baterias_Offshore_a_Despachar"/>
				<entity name="Cap_baterias_Distribuidas_Costa"/>
				<entity name="Horas_Carga_Baterias_1"/>
				<entity name="Consumo_Offshore_por_Bateria"/>
				<entity name="Carga_Baterias_Costa_2"/>
			</group>
			<aux name="Gen Disponible Solar despues de baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(Capacidad_Instalada[Solar]*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado * To_MWH - Consumo_Solar_por_Bateria ,  0)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disponible Solar\nantes de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Capacidad_Instalada[Solar])*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado * To_MWH</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Baterias Costa">
				<eqn>Capacidad_Instalada_Baterias_Costa</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Converter 5" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Cap baterias Distribuidas Costa">
				<eqn>Baterías_Instaladas[Costa]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Solar Distribuidad Disponible Antes de Baterias">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Cap_instalada_Solar_DG_costa)*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado * To_MWH</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disponible Solar 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Cap_instalada_Solar_DG_costa)*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado * To_MWH</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Baterias Distribuidas Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Horas Descarga Baterias" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Paneles Totales por Region" access="input">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<units>MW</units>
			</aux>
			<aux name="Cap instalada Solar DG costa">
				<eqn>Paneles_Totales_por_Region[Costa]</eqn>
				<units>MW</units>
			</aux>
			<aux name="Converter 6">
				<eqn>SUM(Generacion_por_Tecnologia_Costa_Horas[Battery,*])</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Capacidad Instalada\nBaterias Costa" access="input">
				<eqn>0</eqn>
				<units>MWh</units>
			</stock>
			<module name="Carga Baterias Costa">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Carga_Baterias_Costa.Hora_Carga_Bateria" from="Gen_Costa.Horas_Carga_Baterias_1"/>
				<connect2 to="Carga_Baterias_Costa.Hora_Carga_Bateria" from="Horas_Carga_Baterias_1"/>
				<connect to="Carga_Baterias_Costa.Horas_Descarga" from="Gen_Costa.Horas_Descarga_Baterias_Costa"/>
				<connect2 to="Carga_Baterias_Costa.Horas_Descarga" from="Horas_Descarga_Baterias_Costa"/>
				<connect to="Gen_Costa.Converter_5" from="Carga_Baterias_Costa.Disponible_Baterias"/>
				<connect2 to="Converter_5" from="Carga_Baterias_Costa.Disponible_Baterias"/>
				<connect to="Carga_Baterias_Costa.Ajuste_Hora" from="Gen_Costa.Ajuste_Unidad_Gen_12_horas"/>
				<connect2 to="Carga_Baterias_Costa.Ajuste_Hora" from="Ajuste_Unidad_Gen_12_horas"/>
				<connect to='Carga_Baterias_Costa."Cap_Bateria_MWh_-_Input"' from="Gen_Costa.Cap_Baterias_Costa"/>
				<connect2 to='Carga_Baterias_Costa."Cap_Bateria_MWh_-_Input"' from="Cap_Baterias_Costa"/>
				<connect to="Carga_Baterias_Costa.Eficiencia_Bateria" from="Gen_Costa.Eficiencia_Batería"/>
				<connect2 to="Carga_Baterias_Costa.Eficiencia_Bateria" from="Eficiencia_Batería"/>
				<connect to="Gen_Costa.Uso_Tec1_por_Carga_Bateria" from="Carga_Baterias_Costa.Consumo_Tec_1_Por_Carga_de_Bateria"/>
				<connect2 to="Uso_Tec1_por_Carga_Bateria" from="Carga_Baterias_Costa.Consumo_Tec_1_Por_Carga_de_Bateria"/>
				<connect to="Carga_Baterias_Costa.Distribucion_Horas" from="Gen_Costa.Porcentaje_Faltantes"/>
				<connect2 to="Carga_Baterias_Costa.Distribucion_Horas" from="Porcentaje_Faltantes"/>
				<connect to="Carga_Baterias_Costa.Tec1_Gen_Dispo" from="Gen_Costa.Disponibilidad_Tec_1"/>
				<connect2 to="Carga_Baterias_Costa.Tec1_Gen_Dispo" from="Disponibilidad_Tec_1"/>
				<connect to="Carga_Baterias_Costa.Excedentes_Energia_Costa_Horas" from="Gen_Costa.Excedentes_Energia_Costa_Horas"/>
				<connect2 to="Carga_Baterias_Costa.Excedentes_Energia_Costa_Horas" from="Excedentes_Energia_Costa_Horas"/>
			</module>
			<aux name="Uso Tec1 por Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Converter 7" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Merito T1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Demanda_Costa_24h- Autoregeneracion_Costa_por_Horas)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Instalada">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
