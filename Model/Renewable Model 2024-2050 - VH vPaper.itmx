	</model>
	<model name="Calculo_Precio_Electricidad_Costa_Dia">
		<variables>
			<aux name="Generacion Odernada" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Costo para Despacho Ordenado" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>USD/kWh</units>
			</aux>
			<aux name="Oferta">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Suma 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Oferta&gt;0)THEN
   IF (Suma_0&lt;Oferta)THEN
      Suma_0 +Generacion_Odernada[1,Horas24]
   ELSE
      Suma_0
ELSE
   0</eqn>
				<format precision="0.0001"/>
				<units>MWh</units>
			</aux>
			<aux name="Suma 0">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Oferta&gt;0)THEN
   IF (Suma_0&lt;Oferta)THEN
      Costo_para_Despacho_Ordenado[1]
   ELSE
      0
ELSE
   0</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_1&lt;Oferta)THEN
   Suma_1+Generacion_Odernada[2,Horas24]
ELSE
   Suma_1</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_1&lt;Oferta)THEN
   Costo_para_Despacho_Ordenado[2]
ELSE
   Precio_1</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_2&lt;Oferta)THEN
   Suma_2+Generacion_Odernada[3,Horas24]
ELSE
   Suma_2</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_2&lt;Oferta)THEN
   Costo_para_Despacho_Ordenado[3]
ELSE
   Precio_2</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 4">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_3&lt;Oferta)THEN
   Suma_3+Generacion_Odernada[4,Horas24]
ELSE
   Suma_3</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 4">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_3&lt;Oferta)THEN
   Costo_para_Despacho_Ordenado[4]
ELSE
   Precio_3</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 5">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_4&lt;Oferta)THEN
   Suma_4+Generacion_Odernada[5,Horas24]
ELSE
   Suma_4</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 5">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_4&lt;Oferta)THEN
   Costo_para_Despacho_Ordenado[5]
ELSE
   Precio_4</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Suma 6">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_5&lt;Oferta)THEN
   Suma_5+Generacion_Odernada[6,Horas24]
ELSE
   Suma_5</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio 6">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Suma_5&lt;Oferta)THEN
   Costo_para_Despacho_Ordenado[6]
ELSE
   Precio_5</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Check SUMA">
				<eqn>SUM(Generacion_Odernada)</eqn>
