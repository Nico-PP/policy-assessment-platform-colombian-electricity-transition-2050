				</element>
				<element subscript="Costa, H10">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H10]</eqn>
				</element>
				<element subscript="Costa, H11">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H11]</eqn>
				</element>
				<element subscript="Costa, H12">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H12]</eqn>
				</element>
				<element subscript="Costa, H13">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H13]</eqn>
				</element>
				<element subscript="Costa, H14">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H14]</eqn>
				</element>
				<element subscript="Costa, H15">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H15]</eqn>
				</element>
				<element subscript="Costa, H16">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H16]</eqn>
				</element>
				<element subscript="Costa, H17">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H17]</eqn>
				</element>
				<element subscript="Costa, H18">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H18]</eqn>
				</element>
				<element subscript="Costa, H19">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H19]</eqn>
				</element>
				<element subscript="Costa, H20">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H20]</eqn>
				</element>
				<element subscript="Costa, H21">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H21]</eqn>
				</element>
				<element subscript="Costa, H22">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H22]</eqn>
				</element>
				<element subscript="Costa, H23">
					<eqn>Generacion_Futura_Wind_Region[Costa] *FC_Costa_Wind_Ajustado[H23]</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Factor de Carga Solar Ajustado" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura Solar">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Solar,Region]*Serie_Radiacion * Factor_de_Carga_Solar_Ajustado[Horas24] * To_MWH</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Futura Run of River">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Run_of_the_River,Region] *
FC_Hydro_Runof_River[Horas24] *
Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="FC Hydro Runof River" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.50</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura Agregada 24h">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Futura_Gas     +
Generacion_Futura_Oil   +
Generacion_Futura_Coal   +
Generacion_Futura_Others +
Generacion_Futura_Hydro  + 
Generacion_Futura_Solar   +
Generacion_Futura_Wind +
Generacion_Futura_Run_of_River</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Necesaria Region Hora">
				<eqn>(IF((Year = 2027 AND   Mes = 1 AND Year MOD 2 =0 ) ) THEN
MAX( Crecimiento_Oferta ,  Demanda_Objetivo - Generacion_Agregada)
ELSE
0)
+
IF((Year &gt;= 2030 ) AND   Mes = 1 AND Year MOD 2 =0  ) THEN
MAX( Crecimiento_Oferta ,  Demanda_Objetivo - Generacion_Agregada)
ELSE
0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Futura Agregada">
				<eqn>DELAY3(Generacion_Futura_Agregada_Retrasada, 24, 0)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Objetivo">
				<eqn>IF TIME &lt;= 120 THEN
(SUM(Demanda_Centro_Dia)+SUM(Demanda_Costa_Dia)) * (1 + 0.04)^1
ELSE
(SUM(Demanda_Centro_Dia)+SUM(Demanda_Costa_Dia)) * (1 + 0.04) ^1</eqn>
				<units>MWh</units>
			</aux>
			<aux name="FC Costa Wind Ajustado" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura\nAgregada Retrasada">
				<eqn>SUM(Generacion_Futura_Agregada_24h[*,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Agregada">
				<eqn>SUM(Generacion_Futura)-
Generacion_Futura[Gas,Centro] -
Generacion_Futura[Gas,Costa] -
Generacion_Futura[Oil,Centro]-
Generacion_Futura[Oil,Costa] -
Generacion_Futura[Coal,Centro] - 
Generacion_Futura[Coal,Costa]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Actual">
				<eqn>SUM(Demanda_Centro_Dia) + 
SUM(Demanda_Costa_Dia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="LCOE Tecnologia Expansion">
				<doc>Fuente de algunos datos:
Renovables:
https://mc-cd8320d4-36a1-40ac-83cc-3389-cdn-endpoint.azureedge.net/-/media/Files/IRENA/Agency/Publication/2023/Aug/IRENA_Renewable_power_generation_costs_in_2022.pdf?rev=cccb713bf8294cc5bec3f870e1fa15c2


Termicas
https://www.researchgate.net/figure/LCOE-of-different-types-of-power-plant_tbl1_357354732</doc>
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>LCOE_Tecnologia_Expansion_1</eqn>
				<units>USD/KWh</units>
			</aux>
			<aux name="LCOE Tecnologia Expansion 1" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<units>USD/KWh</units>
			</aux>
			<stock name="Capacidad Instalada\nCosta Invisible" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>0</eqn>
				<non_negative/>
				<units>MW</units>
			</stock>
			<stock name="Capacidad Instalada Centro Invisible" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>0</eqn>
				<non_negative/>
				<units>MW</units>
			</stock>
			<aux name="Capacidad\ninstalada centro Ajustada">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Centro-Capacidad_Instalada_Centro_Invisible</eqn>
				<units>MW</units>
			</aux>
			<aux name="Capacidad\ninstalada costa Ajustada">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Costa-Capacidad_Instalada_Costa_Invisible</eqn>
				<units>MW</units>
			</aux>
			<stock name="Capacidad Instalada Centro" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<non_negative/>
				<units>MW</units>
			</stock>
			<stock name="Capacidad Instalada Costa" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<non_negative/>
				<units>MW</units>
			</stock>
			<aux name="Repotenciar Hidro" access="input">
				<eqn>0</eqn>
				<units>unitless</units>
			</aux>
		</variables>
