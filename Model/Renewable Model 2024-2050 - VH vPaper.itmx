			<aux name="Ind Tec x Time" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Total Centro Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Centro[Gas,Horas24] +
Generacion_por_Tecnologia_Centro[Oil,Horas24] +
Generacion_por_Tecnologia_Centro[Coal,Horas24] + 
Generacion_por_Tecnologia_Centro[Others,Horas24] +
Generacion_por_Tecnologia_Centro[Wind,Horas24] + 
Generacion_por_Tecnologia_Centro[Hydro,Horas24] + 
Generacion_por_Tecnologia_Centro[Solar,Horas24] +
Generacion_por_Tecnologia_Centro[Run_of_the_River,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generación Renovable\nCosta 24h">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa[Wind, Horas24]  +
Generacion_por_Tecnologia_Costa[Hydro, Horas24] + 
Generacion_por_Tecnologia_Costa[Solar, Horas24]  +
Generacion_por_Tecnologia_Costa[Run_of_the_River, Horas24] +
Generacion_por_Tecnologia_Costa[Geothermal,Horas24] +
Generacion_por_Tecnologia_Costa[Biomass,Horas24] +
Generacion_por_Tecnologia_Costa[Pump,Horas24] +
Generacion_por_Tecnologia_Costa[Hydrogen,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Total Costa Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa[Gas,Horas24] +
Generacion_por_Tecnologia_Costa[Oil,Horas24] +
Generacion_por_Tecnologia_Costa[Coal,Horas24] + 
Generacion_por_Tecnologia_Costa[Others,Horas24] +
Generacion_por_Tecnologia_Costa[Wind,Horas24] + 
Generacion_por_Tecnologia_Costa[Hydro,Horas24] + 
Generacion_por_Tecnologia_Costa[Solar,Horas24] +
Generacion_por_Tecnologia_Costa[Run_of_the_River,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Indice Tecnologias" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Facfor Dia" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Facfor Noche" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Excedente Energia\nRenovable Costa Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Excedente_Energia_por_Horas_Costa * Factor_Dia[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedente Energia\nCentro Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Excedente_Energia_por_Horas_Centro * Factor_Dia[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Merito Costa Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Converter_4 - 
Autoregeneracion_Costa</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Indice Vector Tec 2" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<module name="Calculo Previo Gen Costa Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Previo_Gen_Costa_Dia.Precio_Electricidad" from="Calculo_Previo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_24h"/>
				<connect2 to="Calculo_Previo_Gen_Costa_Dia.Precio_Electricidad" from="Calculo_Previo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_24h"/>
				<connect to="Calculo_Previo_Gen_Costa_Dia.Costo_para_Despacho_Ordenado" from="Transmision_entre_Zonas.Costo_para_Despacho_Ordenado_Costa_Dia"/>
				<connect2 to="Calculo_Previo_Gen_Costa_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado_Costa_Dia"/>
				<connect to="Calculo_Previo_Gen_Costa_Dia.Generacion_Odernada" from="Transmision_entre_Zonas.Generacion_Disp_Costa_24h_Ordenada"/>
				<connect2 to="Calculo_Previo_Gen_Costa_Dia.Generacion_Odernada" from="Generacion_Disp_Costa_24h_Ordenada"/>
				<connect to="Transmision_entre_Zonas.Generacion_Tecnologias_1" from="Calculo_Previo_Gen_Costa_Dia.Generacion_Tecnologias"/>
				<connect2 to="Generacion_Tecnologias_1" from="Calculo_Previo_Gen_Costa_Dia.Generacion_Tecnologias"/>
				<connect to="Calculo_Previo_Gen_Costa_Dia.Demanda" from="Transmision_entre_Zonas.Demanda_Merito_Costa_Dia"/>
				<connect2 to="Calculo_Previo_Gen_Costa_Dia.Demanda" from="Demanda_Merito_Costa_Dia"/>
			</module>
			<module name="Calculo Previo Precio\nElectricidad Costa Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Generacion_Odernada" from="Transmision_entre_Zonas.Generacion_Disp_Costa_24h_Ordenada"/>
				<connect2 to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Generacion_Odernada" from="Generacion_Disp_Costa_24h_Ordenada"/>
				<connect to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Costo_para_Despacho_Ordenado" from="Transmision_entre_Zonas.Costo_para_Despacho_Ordenado_Costa_Dia"/>
				<connect2 to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado_Costa_Dia"/>
				<connect to="Calculo_Previo_Gen_Costa_Dia.Precio_Electricidad" from="Calculo_Previo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_24h"/>
				<connect2 to="Calculo_Previo_Gen_Costa_Dia.Precio_Electricidad" from="Calculo_Previo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_24h"/>
				<connect to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Demanda" from="Transmision_entre_Zonas.Demanda_Merito_Costa_Dia"/>
				<connect2 to="Calculo_Previo_Precio_Electricidad_Costa_Dia.Demanda" from="Demanda_Merito_Costa_Dia"/>
			</module>
			<aux name="Generacion Costa dia ordenada">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Tecnologias_1[Costos_Ordenados_Costa_Dia[Indice_Tec]+1, Horas24]</eqn>
				<units>MWh</units>
			</aux>
