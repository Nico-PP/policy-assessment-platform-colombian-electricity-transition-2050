				<eqn>FC_Hydro_Embalse</eqn>
				<units>unitless</units>
			</aux>
			<aux name="FC Hydro Embalse" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.50</eqn>
				<units>unitless</units>
			</aux>
			<aux name="FC Costa Solar Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Factor de Carga Solar Ajustado" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>FC_Costa_Solar_Horario / SUM(FC_Costa_Solar_Horario)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="FC Hydro Runof River" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.50</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Serie Radiacion 1" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>hr</units>
			</aux>
			<module name="Calculo Precio\nElectricidad Costa Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Precio_Electricidad_Costa_Dia.Generacion_Odernada" from="Gen_Costa.Generacion_Disp_Costa_24h_Ordenada"/>
				<connect2 to="Calculo_Precio_Electricidad_Costa_Dia.Generacion_Odernada" from="Generacion_Disp_Costa_24h_Ordenada"/>
				<connect to="Calculo_Precio_Electricidad_Costa_Dia.Costo_para_Despacho_Ordenado" from="Gen_Costa.Costo_para_Despacho_Ordenado"/>
				<connect2 to="Calculo_Precio_Electricidad_Costa_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado"/>
				<connect to="Gen_Costa.Precio_Electricidad" from="Calculo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_Dia"/>
				<connect2 to="Precio_Electricidad" from="Calculo_Precio_Electricidad_Costa_Dia.Precio_Electricidad_Dia"/>
				<connect to="Calculo_Precio_Electricidad_Costa_Dia.Demanda" from="Gen_Costa.Demanda_Merito_Costa_Dia_24h"/>
				<connect2 to="Calculo_Precio_Electricidad_Costa_Dia.Demanda" from="Demanda_Merito_Costa_Dia_24h"/>
			</module>
			<module name="Calculo Gen Costa Dia">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Calculo_Gen_Costa_Dia.Precio_Electricidad" from="Gen_Costa.Precio_Electricidad"/>
				<connect2 to="Calculo_Gen_Costa_Dia.Precio_Electricidad" from="Precio_Electricidad"/>
				<connect to="Calculo_Gen_Costa_Dia.Costo_para_Despacho_Ordenado" from="Gen_Costa.Costo_para_Despacho_Ordenado"/>
				<connect2 to="Calculo_Gen_Costa_Dia.Costo_para_Despacho_Ordenado" from="Costo_para_Despacho_Ordenado"/>
				<connect to="Calculo_Gen_Costa_Dia.Generacion_Odernada" from="Gen_Costa.Generacion_Disp_Costa_24h_Ordenada"/>
				<connect2 to="Calculo_Gen_Costa_Dia.Generacion_Odernada" from="Generacion_Disp_Costa_24h_Ordenada"/>
				<connect to="Gen_Costa.Generacion_Tecnologias" from="Calculo_Gen_Costa_Dia.Generacion_Tecnologias"/>
				<connect2 to="Generacion_Tecnologias" from="Calculo_Gen_Costa_Dia.Generacion_Tecnologias"/>
				<connect to="Calculo_Gen_Costa_Dia.Demanda" from="Gen_Costa.Demanda_Merito_Costa_Dia_24h"/>
				<connect2 to="Calculo_Gen_Costa_Dia.Demanda" from="Demanda_Merito_Costa_Dia_24h"/>
			</module>
			<aux name="Generacion Costa dia ordenada">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Tecnologias[Costos_Ordenados[Indice_Tec]+1, Horas24]</eqn>
				<units>MWh</units>
			</aux>
