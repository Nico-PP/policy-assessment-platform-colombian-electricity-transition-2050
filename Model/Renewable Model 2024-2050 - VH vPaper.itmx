				<element subscript="Gas">
					<gf>
						<xscale min="2021" max="2050"/>
						<yscale min="0" max="2000"/>
						<ypts>1283.070142,1283.070142,1270.778058,1258.597719,1246.305635,1234.01355,1221.721465,1209.541127,1197.249042,1184.956958,1172.776619,1160.484535,1148.19245,1135.900366,1123.720027,1114.445091,1105.170154,1096.006964,1086.732027,1077.568837,1068.2939,1059.018964,1049.855773,1040.580837,1031.3059,1022.14271,1012.867773,1003.592836,994.4296461,985.1547095</ypts>
