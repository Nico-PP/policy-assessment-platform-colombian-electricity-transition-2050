			<aux name="Generacion Tecnologias 1" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Req Energia Renovable\nCentro Noche">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Demanda_Previa_Centro_Post_Autogen - Generación_Renovable_Centro_24h) * Factor_Noche</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedente Energia\nCentro Noche">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Excedente_Energia_por_Horas_Centro * Factor_Noche[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Req Energia\nRenovable Centro Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Demanda_Previa_Centro_Post_Autogen - Generación_Renovable_Centro_24h)*Factor_Dia</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedente Energia por Horas Centro">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Dispo_Centro_24_horas[Indice_Tecnologias[Tecnologias],Horas24]-Generacion_por_Tecnologia_Centro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Costo para Despacho\nCentro Dia">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Costo_para_Despacho_Centro</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Ranking Costo para\nDespacho Centro" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<element subscript="1">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 1)</eqn>
				</element>
				<element subscript="2">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 2)</eqn>
				</element>
				<element subscript="3">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 3)</eqn>
				</element>
				<element subscript="4">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 4)</eqn>
				</element>
				<element subscript="5">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 5)</eqn>
				</element>
				<element subscript="6">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 6)</eqn>
				</element>
				<element subscript="7">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 7)</eqn>
				</element>
				<element subscript="8">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 8)</eqn>
				</element>
				<element subscript="9">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 9)</eqn>
				</element>
				<element subscript="10">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 10)</eqn>
				</element>
				<element subscript="11">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 11)</eqn>
				</element>
				<element subscript="12">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 12)</eqn>
				</element>
				<element subscript="13">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 13)</eqn>
				</element>
				<element subscript="14">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 14)</eqn>
				</element>
				<element subscript="15">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 15)</eqn>
				</element>
				<element subscript="16">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 16)</eqn>
				</element>
				<element subscript="17">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 17)</eqn>
				</element>
				<element subscript="18">
					<eqn>RANK(Costo_para_Despacho_Centro_Dia, 18)</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Costo para Despacho\nOrdenado Centro Dia" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Costo_para_Despacho_Centro_Dia[Ranking_Costo_para_Despacho_Centro]</eqn>
				<format precision="full"/>
				<units>USD/kWh</units>
			</aux>
			<aux name="Costos Ordenados Centro Dia" access="output">
