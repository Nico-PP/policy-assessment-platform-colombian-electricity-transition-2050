			<aux name="Gen disp Costa\ndia 24h con Switch">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>stage3_Generacion_disponible_Costa_Dia_Horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="FC Costa Wind Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Demanda Costa dia">
				<eqn>SUM(Demanda_Costa_24h*Factor_Dia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Costa noche">
				<eqn>SUM(Demanda_Costa_24h*Factor_Noche)</eqn>
				<units>MWh</units>
			</aux>
			<group name="Simulacion Embalse Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Maximo_Embalse"/>
				<entity name="Vertimiento"/>
				<entity name="Embalse"/>
				<entity name="Vol_Efectivo"/>
				<entity name="Gen_Hydro"/>
				<entity name="Mwh_to_Gwh"/>
				<entity name="Gen_para_Embalse"/>
				<entity name="FC_Hydro_Embalse"/>
				<entity name="Potencia_Efectiva_Urra"/>
				<entity name="Aportes_Costa"/>
				<entity name="Gen_Disp_Embalse_Urra_Mes"/>
				<entity name="Minimo_Embalse"/>
				<entity name="Factor_de_Carga_Hidro_Ajustado"/>
				<entity name="Eficiencia_HidroGeneración"/>
				<entity name="Gen_Embalse_Urra"/>
				<entity name="Gen_Disp_Embalse_Urra"/>
				<entity name="Generacion_de_Embalse"/>
			</group>
			<group name="Generacion Viento Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Molinos_Disponibles_Onshore"/>
				<entity name="Tamaño_Hoja_Offshore"/>
				<entity name="Potencia_Viento"/>
				<entity name="To_MW"/>
				<entity name="Area_Molino_Offshore"/>
				<entity name="Potencia_Offshore"/>
				<entity name="Energía_Series_viento_Total_Offshore"/>
				<entity name="To_Watts"/>
				<entity name="Ajuste_Unidad_Energia"/>
				<entity name="To_Joules"/>
				<entity name="Capacidad_Viento_Onshore"/>
				<entity name="Eficiencia_Velocidad_Viento"/>
				<entity name="Molinos_Disponibles_Offshore"/>
				<entity name="Factor_de_carga_eolica_Offshore"/>
				<entity name="Potencia_Viento_Offshore"/>
				<entity name="Capacidad_Molino"/>
				<entity name="Potencia_por_Metro_Cuadrado_Offshore"/>
				<entity name="Converter_19"/>
				<entity name="Capacidad_Molino_Offshore"/>
				<entity name="To_MWH"/>
				<entity name="Potencia_por_Metro_Cuadrado"/>
				<entity name="Eficiencia_Velocidad_Offshore_1"/>
				<entity name="Energía_Series_viento_Total_Onshore"/>
				<entity name="Potencia"/>
				<entity name="Tamaño_Hoja"/>
				<entity name="Factor_de_carga_eolica_Onshore"/>
				<entity name="Eficiencia_Velocidad_Offshore"/>
				<entity name="Capacidad_Viento_Offshore"/>
				<entity name="Area_Molino"/>
				<entity name="Horas_Dias"/>
			</group>
			<aux name="Generacion Total Costa" access="output">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_costa_Dia + Generacion_por_Tecnologia_costa_Noche</eqn>
				<units>MWh</units>
			</aux>
			<group name="Demanda Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Demanda_Costa_noche"/>
				<entity name="Demanda_Costa_dia"/>
				<entity name="Demanda_Total_Costa"/>
				<entity name="Crecimiento_Demanda"/>
				<entity name="INIT_Demanda_Costa"/>
				<entity name="Demanda_Costa_24h"/>
				<entity name="Crecimiento_demanda_Costa_día"/>
			</group>
			<group name="Disponibilidad Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Ajuste_Unidad_Gen_12_horas"/>
				<entity name="stage3_Generacion_disponible_Costa_Dia_Horas"/>
				<entity name="Factor_de_Carga_Solar_Ajustado"/>
				<entity name="FC_Costa_Wind_Ajustado"/>
				<entity name="Importacion_del_Centro"/>
				<entity name="FC_Termicas_Horario"/>
				<entity name="Factor_de_carga_gas"/>
				<entity name="Factor_de_carga_otras"/>
				<entity name="Gen_Wind_Onshore_Disponible_Despues_de_Transmision"/>
				<entity name="Gen_Solar_Disponbile_Luego_de_Transmision"/>
				<entity name="Gen_Wind_Offshore_Disponible_Despues_de_Transmision"/>
				<entity name="Horas_Carga_Baterias"/>
				<entity name="Eficiencia_Batería"/>
				<entity name="Horas_Descarga_Baterias"/>
				<entity name="Factor_de_carga_carbon"/>
				<entity name="Factor_de_carga_Oil"/>
				<entity name="Generacion_Disponible_Costa_por_Tecnologia"/>
				<entity name="Disponibilidad_Solar"/>
				<entity name="Disponibilidad_Eolica"/>
				<entity name="Stage2_Generacion_disponible_Costa_Dia_Horas"/>
				<entity name="Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias"/>
				<entity name="Energia_Disponible_Costa_Hora"/>
				<entity name="Excedentes_Energia_Costa_Horas"/>
				<entity name="Suma_Disponibles"/>
				<entity name="Porcentaje_Faltantes"/>
				<entity name="Suma_Excedentes"/>
				<entity name="Faltantes_Energia_Costa_Horas"/>
				<entity name="Suma_Faltantes"/>
			</group>
			<aux name="Capacidad Viento Onshore">
				<eqn>Capacidad_Instalada[Wind]</eqn>
				<units>MW</units>
			</aux>
			<group name="Ditribucion Generacion Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Generacion_Total_Costa_Noche"/>
				<entity name="Generacion_por_Tecnologia_costa_Noche"/>
				<entity name="Generacion_por_Tecnologia_Hora_Costa_Noche"/>
				<entity name="Uso_Baterias_Solar_DG_Noche_Costa"/>
				<entity name="Costa_Noche_Gen_Renovable"/>
				<entity name="Generacion_por_Tecnologia_costa_Dia"/>
				<entity name="Exportacion_Hidro_Centro_a_Costa_Noche"/>
				<entity name="Uso_Baterias_Solar_DG_Dia_Costa"/>
				<entity name="Generacion_Total_Costa"/>
				<entity name="Generacion_por_Tecnologia_Hora_Costa_Dia"/>
			</group>
			<aux name="Capacidad transmision energia" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Transmision*Confiabilidad_de_la_red*Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<group name="Despacho Costa" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Generacion_por_Tecnologia_Costa_Horas"/>
				<entity name="Autoregeneracion_Costa_por_Horas"/>
				<entity name="Converter_14"/>
				<entity name="Demanda_Merito_T1"/>
				<entity name="Demanda_Merito_Costa_Dia_24h"/>
				<entity name="Converter_12"/>
				<entity name="Solar_DG_Costa"/>
				<entity name="Generacion_por_Tecnologia_Costa_Horas_1"/>
				<entity name="Generacion_Disp_Costa_24h_Ordenada"/>
				<entity name="Ranking_Costo_para_Despachoa"/>
				<entity name="Converter_13"/>
				<entity name="Factor_de_carga_run_of_the_river"/>
				<entity name="Uso_Baterias_AutoGen_Costa"/>
				<entity name="Calculo_Gen_Costa_Dia"/>
				<entity name="Generacion_Tecnologias"/>
				<entity name="Calculo_Precio_Electricidad_Costa_Dia"/>
				<entity name="Porcentaje_de_Generacion_a_Variar"/>
				<entity name="Generacion_Hidro"/>
				<entity name="Gen_disp_Costa_dia_24h_con_Switch"/>
				<entity name="Paneles_Costa_Ajustado"/>
				<entity name="Switch_Off_Hidro"/>
				<entity name="Precio_Electricidad"/>
				<entity name="Costo_para_Despacho_Ordenado"/>
				<entity name="Costo_para_Despacho_Costa_Dia"/>
				<entity name="Costos_Ordenados"/>
				<entity name="Generacion_Costa_dia_ordenada"/>
				<entity name="Baterías_Instaladas"/>
				<entity name="Ind_Precios_Tec1"/>
				<entity name="Serie_Radiacion_1"/>
				<entity name="Generacion_Solar_Distribuida_Costa"/>
				<entity name="Costo_para_Despacho"/>
			</group>
			<aux name="Indice Vector Tec" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Ind Precios Tec1">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Indice_Vector_Tec</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Embalse Urra">
				<eqn>(Embalse - Minimo_Embalse)*Mwh_to_Gwh</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Urra">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Instalada[Hydro] *  Ajuste_Unidad_Gen_12_horas  * 
Factor_de_Carga_Hidro_Ajustado</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Potencia Efectiva Urra">
				<eqn>MIN(Gen_Embalse_Urra, Gen_Disp_Embalse_Urra_Mes)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disp Embalse Urra Mes">
				<eqn>SUM(Gen_Disp_Embalse_Urra) * 30</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Eficiencia HidroGeneración">
				<eqn>0.90</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Hydro">
				<eqn>SUM(Generacion_por_Tecnologia_Costa_Horas[Hydro,*])</eqn>
