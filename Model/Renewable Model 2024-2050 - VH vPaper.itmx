				<units>unitless</units>
			</aux>
			<aux name="Generacion Tecnologias 3" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Costa Satisface Demanda\nNoche con Renovable">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(IF Demanda_Merito_Costa_Dia = Generación_Renovable_Costa_24h THEN
1
ELSE
0) * Factor_Noche</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Costa Satisface Demanda\nDia con Renovable">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(IF Demanda_Merito_Costa_Dia = Generación_Renovable_Costa_24h THEN
1
ELSE
0) * Factor_Dia</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Centro Satisface Demanda\nNoche con Renovable">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(IF Demanda_Previa_Centro_Post_Autogen = Generación_Renovable_Centro_24h THEN
1
ELSE
0) * Factor_Noche

{
1 si satisface la demana con renovables, 
0 no satisface la demanda con  renovables
}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generación Renovable\nCentro 24h">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Centro[Wind, Horas24]  +
Generacion_por_Tecnologia_Centro[Hydro, Horas24] + 
Generacion_por_Tecnologia_Centro[Solar, Horas24]  +
Generacion_por_Tecnologia_Centro[Run_of_the_River, Horas24] +
Generacion_por_Tecnologia_Centro[Battery,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Centro Satisface Demanda\nDia con Renovable">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(IF SUM(Demanda_Previa_Centro_Post_Autogen) = Generación_Renovable_Centro_24h THEN
1
ELSE
0) * Factor_Dia</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Exportacion Solar\nCosta a Centro Dia" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
0
ELSE
MIN(Excedente_Energia_por_Horas_Costa[Solar, Horas24],  Capacidad_transmision_energia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica\nCosta a Centro 24H" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
0
ELSE
MAX(0, MIN(Capacidad_Transmision_energia_restante_Stage1, Excedente_Energia_por_Horas_Costa[Wind, Horas24]))*Cambio_de_Regla</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Transmision\nenergia restante Stage1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_transmision_energia - Exportacion_Solar_Costa_a_Centro_Dia</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Hidro\nCentro a Costa Noche" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
MIN(Capacidad_transmision_energia, Excedente_Energia_Centro_Noche[Hydro, Horas24])
ELSE 
MIN(Capacidad_transmision_energia, Excedente_Energia_Centro_Noche[Hydro, Horas24]) *(1-Cambio_de_Regla)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Calculo Previo Gen Costa Sol Viento" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa[Solar, Horas24] +
Generacion_por_Tecnologia_Costa[Wind, Horas24]

{Calculo de Generacion sol y viento en la costa previo a definir la transmisión de energía}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Solar Panel DG Centro" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Autoregeneracion Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
