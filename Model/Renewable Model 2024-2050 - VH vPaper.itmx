					<of>Carga_Bateria_O_H_23</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4574" x="683" y="133.722" width="18" height="18">
					<of>Gen_Tec_2</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4576" x="936" y="345.167" width="18" height="18">
					<of>Hora_Carga_Bateria</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4581" x="341.222" y="181.5" width="18" height="18">
					<of>Excedentes_Energia_Costa_Horas</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4584" x="584.333" y="179.333" width="18" height="18">
					<of>Excedentes_Energia_Costa_Horas</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4588" x="766.833" y="81" width="18" height="18">
					<of>Excedentes_Energia_Costa_Horas</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4593" x="466.61" y="2456.89" width="18" height="18">
					<of>Horas_Descarga</of>
				</alias>
				<alias font_style="italic" uid="4595" x="614.167" y="2165.22" width="18" height="18">
					<of>Carga_Final_del_dia</of>
				</alias>
				<alias font_style="italic" uid="4597" x="713.167" y="2474.89" width="18" height="18">
					<of>Carga_Final_del_dia</of>
				</alias>
				<alias font_style="italic" font_weight="bold" uid="4603" x="466.61" y="2245.33" width="18" height="18">
					<of>Porcantaje_Faltantes</of>
				</alias>
			</view>
		</views>
	</model>
	<model name="MicroGeneracion">
		<variables>
			<group name="Población - Viviendas" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Familias_x_Region"/>
				<entity name="Poblacion"/>
				<entity name="Tasa_de_Crecimiento_Poblacion"/>
				<entity name="Viviendas_Requeridas"/>
				<entity name="Personas_por_Familia"/>
				<entity name="Familias_por_Vivienda"/>
				<entity name='"%_Familia"'/>
				<entity name="Nueva_Población"/>
				<entity name="Familias"/>
			</group>
			<stock name="Poblacion">
				<eqn>50407647</eqn>
				<format precision="1"/>
				<inflow>Nueva_Población</inflow>
				<non_negative/>
				<units>Persona</units>
			</stock>
			<flow name="Nueva Población">
				<eqn>Poblacion*Tasa_de_Crecimiento_Poblacion</eqn>
				<non_negative/>
				<units>Persona/Months</units>
			</flow>
			<aux name="Tasa de Crecimiento Poblacion">
				<eqn>Año</eqn>
				<gf>
					<yscale min="0" max="0.0015"/>
					<xpts>2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050</xpts>
					<ypts>0.00117331900059,0.00117331900059,0.000921594609175768,0.00085910611364181,0.000766772593700125,0.000655738224446538,0.00057117904007967,0.000519523551573306,0.000482510228851355,0.000457388474842716,0.000442504273021138,0.000427852555968695,0.000408050617863263,0.000387566455831649,0.000367470178158254,0.000347784559790168,0.000325978421659988,0.000302065147357225,0.000278544332829554,0.000255570444250123,0.000232442090680653,0.000209466835387674,0.000187311329384858,0.000165733362722457,0.000144121323071488,0.000122536179413274,0.000101587479358386,0.0000812949342174257,0.000061060721531291,0.0000409176917070802,0.0000209376932262973</ypts>
				</gf>
				<units>1/month</units>
			</aux>
			<aux name="Personas por Familia">
				<eqn>3.9</eqn>
				<units>Persona/Familia</units>
			</aux>
			<aux name="Familias">
				<eqn>Poblacion/Personas_por_Familia</eqn>
				<units>Familia</units>
			</aux>
			<aux name="Familias x Region">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Familias*&quot;%_Familia&quot;</eqn>
				<units>Familia</units>
			</aux>
			<aux name="% Familia">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>0.75</eqn>
				</element>
				<element subscript="Costa">
					<eqn>0.25</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Familias por Vivienda">
				<eqn>1</eqn>
				<units>Familia/Casa</units>
			</aux>
			<aux name="Viviendas Requeridas">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Familias_x_Region/Familias_por_Vivienda</eqn>
				<format precision="1"/>
				<units>Casa</units>
			</aux>
			<group name="Intensida Energetica" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Crecimiento_Intensidad_Energetica"/>
				<entity name="Tasa_crecimiento_mensual_de_la_intensidad"/>
				<entity name="Intensidad_Energetica_Inicial"/>
				<entity name="Intensidad_Energetica"/>
			</group>
			<stock name="Intensidad Energetica">
				<eqn>Intensidad_Energetica_Inicial</eqn>
				<inflow>Crecimiento_Intensidad_Energetica</inflow>
				<non_negative/>
				<units>MWh/Casa</units>
			</stock>
			<flow name="Crecimiento Intensidad Energetica">
				<eqn>Intensidad_Energetica* Tasa_crecimiento_mensual_de_la_intensidad</eqn>
				<non_negative/>
				<units>MWh/Casa/Months</units>
			</flow>
			<aux name="Tasa crecimiento mensual de la intensidad">
				<eqn>0.016/12</eqn>
				<units>1/month</units>
			</aux>
			<aux name="Intensidad Energetica Inicial">
				<eqn>0.145</eqn>
				<units>MWh/Casa</units>
			</aux>
			<group name="Elasticidad Precio Demanda" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Precio_Transporte_y_Otros"/>
				<entity name='"Efecto_precio-demanda"'/>
				<entity name="precio_electricidad_residencial_sin_und"/>
				<entity name='"Elasticidad_demanda-precio"'/>
				<entity name="precio_electricidad_residencial_periodo_ant"/>
				<entity name="precio_electricidad_residencial_2_periodo_ant"/>
				<entity name="Precio_Electricidad"/>
				<entity name="tasa_crecimiento_residencial1"/>
				<entity name="variación_precio_electricidad_residencial"/>
				<entity name="Precio_Electricidad_Residencial"/>
			</group>
			<aux name="Precio Electricidad Residencial">
				<eqn>Precio_Transporte_y_Otros+Precio_Electricidad</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Precio Electricidad">
				<eqn>450</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Precio Transporte y Otros">
				<eqn>250</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precio electricidad residencial sin und">
				<eqn>Precio_Electricidad_Residencial</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precio electricidad residencial periodo ant">
				<eqn>DELAYN(Precio_Electricidad_Residencial, 1, 1, 249)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precio electricidad residencial 2 periodo ant">
				<eqn>DELAYN(Precio_Electricidad_Residencial, 2, 1, 249)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="variación precio electricidad residencial">
				<eqn>(precio_electricidad_residencial_periodo_ant-precio_electricidad_residencial_2_periodo_ant)/precio_electricidad_residencial_periodo_ant</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Efecto precio-demanda">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>tasa_crecimiento_residencial1-variación_precio_electricidad_residencial*&quot;Elasticidad_demanda-precio&quot;</eqn>
				<units>unitless</units>
			</aux>
			<aux name="tasa crecimiento residencial1">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>0.026</eqn>
				</element>
				<element subscript="Costa">
					<eqn>0.027</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Elasticidad demanda-precio">
				<eqn>0.02
{De donde Sale}</eqn>
				<units>unitless</units>
			</aux>
			<group name="Generacion Solar" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="atención_a_la_demanda_con_micro_por_vivienda"/>
				<entity name="Ajuste_Unidad_MW"/>
				<entity name="energía_generada_por_el_panelal_año"/>
				<entity name="Horas_en_un_año"/>
				<entity name="energía_generada_por_panel_al_mes"/>
				<entity name="ratio_de_degradación_eficiencia_anual"/>
				<entity name="Energía_generada_por_panel_al_año"/>
				<entity name="Factor_de_carga_de_los_paneles"/>
				<entity name='"Ajuste_Unidad_MWh/Casa"'/>
				<entity name="capacidad_instalada_panel_solar"/>
			</group>
			<aux name="Factor de carga de los paneles">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>0.4</eqn>
				</element>
				<element subscript="Costa">
					<eqn>0.5</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Horas en un año">
				<eqn>8760</eqn>
				<units>unitless</units>
			</aux>
			<aux name="energía generada por el panelal año">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>capacidad_instalada_panel_solar * 
((1-ratio_de_degradación_eficiencia_anual)^Vida_Util_PV) *
Factor_de_carga_de_los_paneles*Horas_en_un_año /
Ajuste_Unidad_MW</eqn>
				<units>unitless</units>
			</aux>
			<aux name="ratio de degradación eficiencia anual">
				<eqn>0.01</eqn>
				<units>unitless</units>
			</aux>
			<aux name="capacidad instalada panel solar">
				<eqn>0.001</eqn>
				<units>MW</units>
			</aux>
			<aux name="Vida Util PV">
				<eqn>20</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Energía generada por panel al año">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>energía_generada_por_el_panelal_año*&quot;Ajuste_Unidad_MWh/Casa&quot;</eqn>
				<units>MWh/Casa</units>
			</aux>
			<aux name="energía generada por panel al mes">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Energía_generada_por_panel_al_año/12</eqn>
				<units>MWh/Casa</units>
			</aux>
			<aux name="atención a la demanda con micro por vivienda">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>energía_generada_por_panel_al_mes/Intensidad_Energetica</eqn>
				<format precision="0.0001"/>
				<units>unitless</units>
			</aux>
			<aux name="Ajuste Unidad MWh/Casa">
				<eqn>1</eqn>
				<units>MWh/Casa</units>
			</aux>
			<aux name="Ajuste Unidad MW">
				<eqn>1</eqn>
				<units>MW</units>
			</aux>
			<group name="Solar" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Costo_Instalacion_solar_residencial_inicial"/>
				<entity name="Tiempo_inversión_panel"/>
				<entity name="costo_nivelado_de_energía"/>
				<entity name='"precio_solar_-_2"'/>
				<entity name="Vida_Util_PV"/>
				<entity name="Tasa_descuento_residencial_solar"/>
				<entity name="tasa_interés_panel_solar"/>
				<entity name="Incentivo"/>
				<entity name="Costo_instalación_solar_residencial"/>
				<entity name="Costo_instalacion_solar_con_interés"/>
				<entity name="precio_electricidad_solar_sin_und"/>
			</group>
			<aux name="Incentivo">
				<eqn>0.2</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Costo instalación solar residencial">
				<eqn>Costo_Instalacion_solar_residencial_inicial * (1 - Incentivo)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Costo Instalacion solar residencial inicial">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="6000000"/>
					<xpts>1,108,228,348,468</xpts>
					<ypts>5800000,4300000,3552000,2054000,1570000</ypts>
				</gf>
				<units>unitless</units>
			</aux>
			<aux name="Costo instalacion solar con interés">
				<eqn>IF(tasa_interés_panel_solar=0) THEN
Costo_instalación_solar_residencial
ELSE
Costo_instalación_solar_residencial * (1 + tasa_interés_panel_solar) ^(Tiempo_inversión_panel)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Tiempo inversión panel">
				<eqn>3
{unit: year but ithink recommend use unitless since this variable is an exponent}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="tasa interés panel solar">
				<eqn>0.279</eqn>
				<units>unitless</units>
			</aux>
			<aux name="costo nivelado de energía">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(Costo_instalacion_solar_con_interés / ( 1 + Tasa_descuento_residencial_solar)^ (Vida_Util_PV) ) /
( (energía_generada_por_el_panelal_año*Vida_Util_PV) / (1+Tasa_descuento_residencial_solar)^Vida_Util_PV )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precio solar - 2">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>costo_nivelado_de_energía</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Tasa descuento residencial solar">
				<eqn>0.0172</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precio electricidad solar sin und">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>&quot;precio_solar_-_2&quot;/1000</eqn>
				<format precision="0.001"/>
				<units>unitless</units>
			</aux>
			<group name="Bass Micro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="viviendas_potenciales_micro"/>
				<entity name='"Consumo_viviendas_no_conocen_micro-red"'/>
				<entity name='"tasa_contacto_-q_micro"'/>
				<entity name="Viviendas_Totales_Micro"/>
				<entity name="Viviendas_Colombia"/>
				<entity name="Micro"/>
				<entity name="proceso_de_conocimiento_micro"/>
				<entity name="tasa_nuevas_viviendas"/>
				<entity name="Adopción_publicidad_creencia_verde_micro"/>
				<entity name="Total_Viviendas"/>
				<entity name="viviendas_que_conocen_micro"/>
				<entity name="Deficit_viviendas"/>
				<entity name='"Coeficiente_innovación_-p-micro"'/>
				<entity name="Converter_4"/>
				<entity name='"adopción_boca-boca_micro"'/>
				<entity name="Converter_5"/>
				<entity name="Fracción_adopción_conocedores_micro"/>
				<entity name="Converter_3"/>
				<entity name="viviendas_colombia_por_regiones"/>
				<entity name="construcción_de_nuevas_viviendas"/>
				<entity name="factor_de_casas_potenciales_micro"/>
				<entity name="viviendas_que_no_conocen_micro"/>
			</group>
			<aux name="Viviendas Totales Micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>viviendas_que_conocen_micro+viviendas_que_no_conocen_micro</eqn>
				<format precision="1"/>
				<units>Casa</units>
			</aux>
			<stock name="viviendas que no conocen micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>viviendas_colombia_por_regiones</eqn>
				<format precision="1"/>
				<inflow>construcción_de_nuevas_viviendas</inflow>
				<outflow>proceso_de_conocimiento_micro</outflow>
				<non_negative/>
				<units>Casa</units>
			</stock>
			<flow name="construcción de nuevas viviendas">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Deficit_viviendas/tasa_nuevas_viviendas</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<flow name="proceso de conocimiento micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(IF(Micro = 0) THEN
0
ELSE
MIN (viviendas_que_no_conocen_micro/DT, (Adopción_publicidad_creencia_verde_micro+&quot;adopción_boca-boca_micro&quot;)/DT )) / 2 * Converter_4 + Converter_5</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<stock name="viviendas que conocen micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>100</eqn>
				<format precision="1"/>
				<inflow>proceso_de_conocimiento_micro</inflow>
				<non_negative/>
				<units>Casa</units>
			</stock>
			<aux name="viviendas colombia por regiones">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Viviendas_Colombia*&quot;%_Familia&quot;</eqn>
				<format precision="1"/>
				<units>Casa</units>
			</aux>
			<aux name="Consumo viviendas no conocen micro-red">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>viviendas_que_no_conocen_micro*Intensidad_Energetica</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Deficit viviendas">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>MAX(0,  Viviendas_Requeridas-Viviendas_Totales_Micro)</eqn>
				<units>Casa</units>
			</aux>
			<aux name="Viviendas Colombia">
				<eqn>17000000</eqn>
				<format precision="1"/>
				<units>Casa</units>
			</aux>
			<aux name="Micro">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="tasa nuevas viviendas">
				<eqn>12</eqn>
				<units>Months</units>
			</aux>
			<aux name="viviendas potenciales micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>factor_de_casas_potenciales_micro*viviendas_que_no_conocen_micro</eqn>
				<units>Casa</units>
			</aux>
			<aux name="factor de casas potenciales micro">
				<eqn>0.12</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Adopción publicidad creencia verde micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>&quot;Coeficiente_innovación_-p-micro&quot;*viviendas_potenciales_micro</eqn>
				<units>Casa</units>
			</aux>
			<aux name="Coeficiente innovación -p-micro">
				<eqn>0.006
{0,0914}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="adopción boca-boca micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>viviendas_que_conocen_micro*Fracción_adopción_conocedores_micro*viviendas_potenciales_micro*&quot;tasa_contacto_-q_micro&quot;/Viviendas_Totales_Micro</eqn>
				<units>Casa</units>
			</aux>
			<aux name="Fracción adopción conocedores micro">
				<eqn>0.035</eqn>
				<units>unitless</units>
			</aux>
			<aux name="tasa contacto -q micro">
				<eqn>0.10</eqn>
				<units>unitless</units>
			</aux>
			<group name="MicroGeneracion -\nEntrada de Variables" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Poder_Ciudadano_Verde"/>
				<entity name="Total_Horas_Carga"/>
				<entity name="Serie_Radiacion"/>
				<entity name="Factor_de_Carga_Solar_Ajustado"/>
				<entity name="Año"/>
				<entity name="BAU"/>
				<entity name="Poder_Politico_Verde"/>
			</group>
			<aux name="BAU" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Poder Politico Verde" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Poder Ciudadano Verde" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<group name="Sector Micro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name='"%_consumo_red_con_micro"'/>
				<entity name="Gama_conocen_y_creen_micro"/>
				<entity name="CC_conocen_y_creen_micro"/>
				<entity name='"%_posibles_viviendas_conocen_y_creen_-micro"'/>
				<entity name="Posibles_viviendas_sustitución_micro_creen"/>
				<entity name="Nuevas_viviendas_que_conocen_y_creen_micro"/>
				<entity name="Consumo_viviendas_con_panel_solar"/>
				<entity name="viviendas_micro"/>
				<entity name="Nuevas_viviendas_que_conocen_pero_no_creen"/>
				<entity name="Consumo_viviendas_micro_complementario_red"/>
				<entity name="Reselección_micro"/>
				<entity name='"%posibles_viviendas_conocen-micro_y_no_creen"'/>
				<entity name="Posibles_viviendas_sustitución_micro_no_creen"/>
				<entity name="CC_conocen_no_creen_micro"/>
				<entity name="Gama_conocen_y_no_creen_micro"/>
				<entity name="Nuevas_viviendas_no_seleccionan_micro"/>
				<entity name="CC_no_seleccionan_micro"/>
				<entity name="viviendas_conocen_pero_no_seleccionan_micro"/>
				<entity name='"Consumo_viviendas_no_seleccionan_micro_-red"'/>
				<entity name='"Ajuste_Unidad_Solar_MWh/Panel"'/>
				<entity name="Gama_reseleccionan_micro"/>
				<entity name="Nuevos_paneles"/>
				<entity name="Nuevos_Paneles_Parte_1"/>
				<entity name="Nuevos_Paneles_Parte_2"/>
				<entity name="Ajuste_Unidad_Vatios"/>
				<entity name="Paneles_Solares_Instalados"/>
				<entity name="Salida_de_paneles"/>
				<entity name="Tamaño_panel"/>
				<entity name="Tasa_de_salida_paneles"/>
				<entity name="Paneles_Totales_por_Region"/>
				<entity name="Entrada_Forzada_Solar_DG"/>
				<entity name="Paneles_Centro"/>
				<entity name="Entrada_Nuevas_Baterias"/>
				<entity name="Diffrerencia_Sistema_con_Baterias"/>
				<entity name="Factor_Crecimiento_Baterias"/>
				<entity name="Horas_Carga_Bateria"/>
				<entity name="Entrada_Capacidad_Baterias_Dist"/>
				<entity name="Baterías_Instaladas"/>
				<entity name="Paneles_Totales"/>
				<entity name="Entrada_Forzada_Baterias"/>
				<entity name="Capacidad_Baterias_Distribuidas"/>
				<entity name="Total_Baterias_Distribuidas"/>
			</group>
			<aux name="Gama conocen y creen micro">
				<eqn>-10</eqn>
				<units>unitless</units>
			</aux>
			<aux name="CC conocen y creen micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>precio_electricidad_solar_sin_und^(Gama_conocen_y_creen_micro) /
((precio_electricidad_residencial_sin_und ^Gama_conocen_y_creen_micro) + precio_electricidad_solar_sin_und ^Gama_conocen_y_creen_micro)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="% posibles viviendas conocen y creen -micro">
				<eqn>0.4</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Posibles viviendas sustitución micro creen">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>proceso_de_conocimiento_micro * 
&quot;%_posibles_viviendas_conocen_y_creen_-micro&quot; * 
CC_conocen_y_creen_micro</eqn>
				<units>Casa/Months</units>
			</aux>
			<stock name="viviendas micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<format precision="1"/>
				<inflow>Nuevas_viviendas_que_conocen_y_creen_micro</inflow>
				<inflow>Nuevas_viviendas_que_conocen_pero_no_creen</inflow>
				<inflow>Reselección_micro</inflow>
				<non_negative/>
				<units>Casa</units>
			</stock>
			<flow name="Nuevas viviendas que conocen y creen micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(IF(BAU=1)THEN
0.6
ELSE
( IF Poder_Politico_Verde = 1 THEN 1.5 ELSE 0.2 ) *
( IF Poder_Ciudadano_Verde = 1 THEN 0.8 ELSE 0.2)) *
Posibles_viviendas_sustitución_micro_creen * 0.4 {And BAU &lt;&gt;1}</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<flow name="Nuevas viviendas que conocen pero no creen">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(IF(Poder_Politico_Verde) THEN 1 ELSE 0.3) *
(IF(Poder_Ciudadano_Verde) THEN 1.3 ELSE 0.4) *
Posibles_viviendas_sustitución_micro_no_creen</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<aux name="Consumo viviendas con panel solar" access="output">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>atención_a_la_demanda_con_micro_por_vivienda* 
Intensidad_Energetica *
viviendas_micro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Consumo viviendas micro complementario red">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>&quot;%_consumo_red_con_micro&quot; * 
Intensidad_Energetica * 
viviendas_micro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="% consumo red con micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>MAX(0,  1 - atención_a_la_demanda_con_micro_por_vivienda)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="%posibles viviendas conocen-micro y no creen">
				<eqn>0.9</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Posibles viviendas sustitución micro no creen">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>&quot;%posibles_viviendas_conocen-micro_y_no_creen&quot; * proceso_de_conocimiento_micro * CC_conocen_no_creen_micro</eqn>
				<units>Casa/Months</units>
			</aux>
			<aux name="CC conocen no creen micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>precio_electricidad_solar_sin_und^Gama_conocen_y_no_creen_micro / ( ( precio_electricidad_solar_sin_und^Gama_conocen_y_no_creen_micro + precio_electricidad_residencial_sin_und^Gama_conocen_y_no_creen_micro ) )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gama conocen y no creen micro">
				<eqn>-10
{-2}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gama reseleccionan micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>IF(precio_electricidad_residencial_sin_und&gt;precio_electricidad_solar_sin_und) THEN
-0.1
ELSE
-8</eqn>
				<units>unitless</units>
			</aux>
			<aux name="CC no seleccionan micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>precio_electricidad_solar_sin_und^Gama_reseleccionan_micro /
( (precio_electricidad_residencial_sin_und^Gama_reseleccionan_micro + precio_electricidad_solar_sin_und^Gama_reseleccionan_micro) )</eqn>
				<units>unitless</units>
			</aux>
			<stock name="viviendas conocen pero\nno seleccionan micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Nuevas_viviendas_no_seleccionan_micro</inflow>
				<outflow>Reselección_micro</outflow>
				<non_negative/>
				<units>Casa</units>
			</stock>
			<flow name="Reselección micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(IF(Poder_Ciudadano_Verde=1)THEN
1.3
ELSE
0.3) * 
CC_no_seleccionan_micro * viviendas_conocen_pero_no_seleccionan_micro / DT</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<flow name="Nuevas viviendas no seleccionan micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>proceso_de_conocimiento_micro - (Nuevas_viviendas_que_conocen_y_creen_micro + Nuevas_viviendas_que_conocen_pero_no_creen)</eqn>
				<non_negative/>
				<units>Casa/Months</units>
			</flow>
			<aux name="Consumo viviendas no seleccionan micro -red">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>viviendas_conocen_pero_no_seleccionan_micro*Intensidad_Energetica</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Microgeneracion No Residencial Centro" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Microgeneracion_Comercial_Centro+Microgeneracion_industria_Centro</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Paneles Instalados industria" access="output">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>60</eqn>
				<inflow>Cremiento_neto_Industrial</inflow>
				<non_negative/>
				<units>MW</units>
			</stock>
			<flow name="Cremiento neto Industrial">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Crecimiento_Paneles_Industria*0</eqn>
				<non_negative/>
				<units>MW/month</units>
			</flow>
			<aux name="Crecimiento\nPaneles Industria">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Nuevos_Paneles_Industria/DT * 
(IF (Poder_Politico_Verde=1) THEN 1 ELSE 0.5) *
(IF (Poder_Ciudadano_Verde=1) THEN 1 ELSE 0.7)</eqn>
				<units>MW/month</units>
			</aux>
			<stock name="Paneles Solares Instalados" access="output">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Nuevos_paneles</inflow>
				<outflow>Salida_de_paneles</outflow>
				<non_negative/>
				<units>MW</units>
			</stock>
			<flow name="Nuevos paneles">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Nuevos_Paneles_Parte_1*Nuevos_Paneles_Parte_2*Tamaño_panel
+
Entrada_Forzada_Solar_DG</eqn>
				<non_negative/>
				<units>MW/month</units>
			</flow>
			<flow name="Salida de paneles">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Paneles_Solares_Instalados * Tasa_de_salida_paneles</eqn>
				<non_negative/>
				<units>MW/month</units>
			</flow>
			<aux name="Tamaño panel">
				<eqn>0.00400</eqn>
				<units>MW/Casa</units>
			</aux>
			<aux name="Tasa de salida paneles">
				<eqn>0.01/12</eqn>
				<units>1/Months</units>
			</aux>
			<aux name="Paneles Totales por Region" access="output">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Paneles_Solares_Instalados+Paneles_Instalados_industria+Paneles_Instalados_Comercial</eqn>
				<units>MW</units>
			</aux>
			<aux name="Ajuste Unidad Solar MWh/Panel">
				<eqn>12</eqn>
				<units>MWh/MW</units>
			</aux>
			<aux name="Nuevos Paneles Parte 1">
				<eqn>(IF(Poder_Politico_Verde=1)THEN 1 ELSE 0.3) *
(IF(Poder_Ciudadano_Verde = 1)THEN 1 ELSE 0.2 )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Paneles Centro">
				<eqn>Paneles_Solares_Instalados[Centro]+Paneles_Instalados_industria[Centro]</eqn>
				<units>MW</units>
			</aux>
			<aux name="Factor de Carga Solar Ajustado" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Serie Radiacion" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>hr</units>
			</aux>
			<aux name="Nuevos Paneles Parte 2">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(Nuevas_viviendas_que_conocen_y_creen_micro+Reselección_micro+Nuevas_viviendas_que_conocen_pero_no_creen)</eqn>
				<units>Casa/Months</units>
			</aux>
			<stock name="Baterías Instaladas" access="output" isee:autocreated="true">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Entrada_Nuevas_Baterias</inflow>
				<units>MWh</units>
			</stock>
			<flow name="Entrada Nuevas Baterias">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>(IF TIME &lt;=48 THEN 0 ELSE
Diffrerencia_Sistema_con_Baterias*Factor_Crecimiento_Baterias)
+
Entrada_Forzada_Baterias/DT</eqn>
				<non_negative/>
				<units>MWh/Month</units>
			</flow>
			<aux name="Diffrerencia Sistema con Baterias">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>((Paneles_Solares_Instalados +Paneles_Instalados_industria + Paneles_Instalados_Comercial)  - Capacidad_Baterias_Distribuidas) / DT *Ajuste_Unidad_Vatios</eqn>
				<units>MWh/Month</units>
			</aux>
			<group name="Sector Industrial" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Adopcion_Micro_Industria"/>
				<entity name="Cremiento_neto_Industrial"/>
				<entity name="Industrias_Potenciales"/>
				<entity name="Tasa_Innovacion_Industria"/>
				<entity name="Crecimiento_Paneles_Industria"/>
				<entity name="Microgeneracion_industria_Centro"/>
				<entity name="Microgeneracion_industria_Costa"/>
				<entity name="Tasa_Contacto_Industria"/>
				<entity name="Adopcion_Boca_a_Boca_en_Industria"/>
				<entity name="Nuevos_Paneles_Industria"/>
				<entity name="Tasa_Imitación_Industria"/>
				<entity name="Adopcion_por_Innovacion_Industria"/>
				<entity name="Total_Industrias"/>
				<entity name="Industrias_conocen_Micro"/>
				<entity name="Tamaño_Panel_Industria"/>
				<entity name="Paneles_Instalados_industria"/>
			</group>
			<group name="Sector Comercial" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Tamaño_Panel_Comercio"/>
				<entity name="Microgeneracion_No_Residencial_Centro"/>
				<entity name="crecimiento_Paneles_Comercial"/>
				<entity name="Tasa_Imitación_Comercio"/>
				<entity name="Nuevos_Paneles_Comercio"/>
				<entity name="Adopcion_Micro_Comercios"/>
				<entity name="Comercio_conocen_Micro"/>
				<entity name="Tasa_Contacto_Comercio"/>
				<entity name="Microgeneracion_Comercial_Centro"/>
				<entity name="Comercios_Potenciales"/>
				<entity name="Microgeneracion_No_Residencial_Costa"/>
				<entity name="Microgeneracion_Comercial_Costa"/>
				<entity name="Adopcion_Boca_a_Boca_en_Comecio"/>
				<entity name="Ajuste_unidad_MW_to_Mwh"/>
				<entity name="Adopcion_por_Innovacion_Comercio"/>
				<entity name="Total_Comercio"/>
				<entity name="Tasa_Innovacion_Comercio"/>
			</group>
			<aux name="Microgeneracion\nComercial Centro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Paneles_Instalados_Comercial[Centro]*Serie_Radiacion*Factor_de_Carga_Solar_Ajustado*Ajuste_unidad_MW_to_Mwh</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Paneles Instalados Comercial" access="output">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>60</eqn>
				<inflow>Cremiento_neto_Comercial</inflow>
				<non_negative/>
				<units>MW</units>
			</stock>
			<flow name="Cremiento neto Comercial">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>crecimiento_Paneles_Comercial</eqn>
				<non_negative/>
				<units>MW/month</units>
			</flow>
			<aux name="crecimiento\nPaneles Comercial">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Nuevos_Paneles_Comercio/DT * 
(IF (Poder_Politico_Verde=1) THEN 1 ELSE 0.5) *
(IF (Poder_Ciudadano_Verde=1) THEN 1 ELSE 0.7)</eqn>
				<units>MW/month</units>
			</aux>
			<aux name="Ajuste unidad MW to Mwh">
				<eqn>1</eqn>
				<units>MWh/(MW*hr)</units>
			</aux>
			<aux name="Microgeneracion industria Centro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Paneles_Instalados_industria[Centro]*Serie_Radiacion*Factor_de_Carga_Solar_Ajustado*Ajuste_unidad_MW_to_Mwh</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Industrias Potenciales">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>107191 * 0.65</eqn>
				</element>
				<element subscript="Costa">
					<eqn>107191 * 0.35</eqn>
				</element>
				<outflow>Adopcion_Micro_Industria</outflow>
				<non_negative/>
				<units>unit</units>
			</stock>
			<stock name="Industrias conocen Micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Adopcion_Micro_Industria</inflow>
				<non_negative/>
				<units>unit</units>
			</stock>
			<flow name="Adopcion Micro Industria">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Adopcion_por_Innovacion_Industria+Adopcion_Boca_a_Boca_en_Industria</eqn>
				<non_negative/>
				<units>unit/Months</units>
			</flow>
			<aux name="Adopcion por Innovacion Industria">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Industrias_Potenciales*Tasa_Innovacion_Industria</eqn>
				<units>unit/Months</units>
			</aux>
			<aux name="Tasa Innovacion Industria">
				<eqn>0.0001</eqn>
				<units>1/month</units>
			</aux>
			<aux name="Adopcion Boca a Boca en Industria">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Industrias_conocen_Micro*Industrias_Potenciales*Tasa_Contacto_Industria*Tasa_Imitación_Industria/Total_Industrias</eqn>
				<units>unit/Months</units>
			</aux>
			<aux name="Tasa Imitación Industria">
				<eqn>0.018</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Tasa Contacto Industria">
				<eqn>0.5</eqn>
				<units>1/month</units>
			</aux>
			<aux name="Total Industrias">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Industrias_Potenciales+Industrias_conocen_Micro</eqn>
				<units>unit</units>
			</aux>
			<aux name="Nuevos Paneles Industria">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Industrias_conocen_Micro*Tamaño_Panel_Industria</eqn>
				<units>MW</units>
			</aux>
			<aux name="Tamaño Panel Industria">
				<eqn>0.0035*2</eqn>
				<units>MW/unit</units>
			</aux>
			<stock name="Comercios Potenciales">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>1140104 * 0.65</eqn>
				</element>
				<element subscript="Costa">
					<eqn>1140104 * 0.35</eqn>
				</element>
				<outflow>Adopcion_Micro_Comercios</outflow>
				<non_negative/>
				<units>unit</units>
			</stock>
			<stock name="Comercio conocen Micro">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>0</eqn>
				<inflow>Adopcion_Micro_Comercios</inflow>
				<non_negative/>
				<units>unit</units>
			</stock>
			<flow name="Adopcion Micro Comercios">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Adopcion_por_Innovacion_Comercio+Adopcion_Boca_a_Boca_en_Comecio</eqn>
				<non_negative/>
				<units>unit/Months</units>
			</flow>
			<aux name="Adopcion por\nInnovacion Comercio">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Comercios_Potenciales*Tasa_Innovacion_Comercio</eqn>
				<units>unit/Months</units>
			</aux>
			<aux name="Tasa Innovacion Comercio">
				<eqn>0.0001</eqn>
				<units>1/Month</units>
			</aux>
			<aux name="Adopcion Boca a\nBoca en Comecio">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Comercio_conocen_Micro*Comercios_Potenciales*Tasa_Contacto_Comercio*Tasa_Imitación_Comercio/Total_Comercio</eqn>
				<units>unit/Months</units>
			</aux>
			<aux name="Tasa Imitación Comercio">
				<eqn>0.010</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Tasa Contacto Comercio">
				<eqn>0.5</eqn>
				<units>1/month</units>
			</aux>
			<aux name="Total Comercio">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Comercios_Potenciales+Comercio_conocen_Micro</eqn>
				<units>unit</units>
			</aux>
			<aux name="Nuevos Paneles Comercio">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Comercio_conocen_Micro*Tamaño_Panel_Comercio</eqn>
				<units>MW</units>
			</aux>
			<aux name="Tamaño Panel Comercio">
				<eqn>0.00035</eqn>
				<units>MW/unit</units>
			</aux>
			<aux name="Paneles Totales">
				<eqn>SUM(Paneles_Totales_por_Region)</eqn>
				<units>MW</units>
			</aux>
			<aux name="Microgeneracion\nNo Residencial Costa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Microgeneracion_Comercial_Costa+Microgeneracion_industria_Costa</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Microgeneracion\nComercial Costa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Paneles_Instalados_Comercial[Costa]*Serie_Radiacion*Factor_de_Carga_Solar_Ajustado*Ajuste_unidad_MW_to_Mwh</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Microgeneracion\nindustria Costa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Paneles_Instalados_industria[Costa]*Serie_Radiacion*Factor_de_Carga_Solar_Ajustado*Ajuste_unidad_MW_to_Mwh</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Total Viviendas">
				<eqn>SUM(Viviendas_Totales_Micro)</eqn>
				<format precision="1"/>
				<units>Casa</units>
			</aux>
			<stock name="Año" access="input">
				<eqn>2021</eqn>
				<non_negative/>
				<units>Year</units>
			</stock>
			<aux name="Converter 3">
				<eqn>SUM(viviendas_que_conocen_micro)</eqn>
				<units>Casa</units>
			</aux>
			<aux name="Ajuste Unidad Vatios">
				<eqn>1</eqn>
				<units>MWh/MW</units>
			</aux>
			<aux name="Factor Crecimiento Baterias">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="1" max="360.000000000002"/>
					<yscale min="0" max="0.2"/>
