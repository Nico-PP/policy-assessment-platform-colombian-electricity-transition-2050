			</aux>
			<aux name="Hydro Costa">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Copia_Generacion_disponible_Costa_Dia_Horas[6,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Energia Disponible\ndesde Centro" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
Exportacion_Hidro_Centro_a_Costa_Noche + Exportacion_Hidro_Centro_a_Costa_Dia
ELSE
Exportacion_Hidro_Centro_a_Costa_Noche</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Copia Generacion disponible\nCentro Horas" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Copia Generacion disponible\nCosta Dia Horas" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Hidro\nCentro a Costa Dia" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
MIN(Capacidad_transmision_energia, Excedente_Energia_Centro_Dia[Hydro, Horas24])
ELSE
0</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Año" access="input">
				<eqn>2021</eqn>
				<non_negative/>
				<units>Year</units>
			</stock>
			<aux name="Año en Simulacion">
				<eqn>Año</eqn>
				<units>Years</units>
			</aux>
			<aux name="Año Cambio Regla de Linea" access="input">
