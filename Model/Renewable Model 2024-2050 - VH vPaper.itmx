				<connect2 to="Carga_Baterias_Costa_2.Ajuste_Hora" from="Ajuste_Unidad_Gen_12_horas"/>
				<connect to='Carga_Baterias_Costa_2."Cap_Bateria_MWh_-_Input"' from="Gen_Costa.Cap_baterias_Distribuidas_Costa"/>
				<connect2 to='Carga_Baterias_Costa_2."Cap_Bateria_MWh_-_Input"' from="Cap_baterias_Distribuidas_Costa"/>
