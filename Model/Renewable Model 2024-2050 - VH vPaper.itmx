				<units>MWh</units>
			</aux>
			<aux name="Suma Distribucion">
				<eqn>SUM(Distribucion_Horas_1)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Distribucion Horas 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Horas_Descarga</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Distribucion Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Distribucion_Horas_1, Suma_Distribucion, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Descarga para Faltantes">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Carga_Final_del_dia*Distribucion_Horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Descarga por Distribucion">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Carga_Final_del_dia*Distribucion_Ajustada</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Descarga">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Descarga_para_Faltantes+Descarga_por_Distribucion</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Proporcion Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Descarga, SUM(Descarga), 0)</eqn>
				<units>unitless</units>
			</aux>
		</variables>
