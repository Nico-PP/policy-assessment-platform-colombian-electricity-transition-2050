			<aux name="Microgeneracion industria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Autogeneracion Solar Centro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Paneles_Centro_Ajustado*Factor_de_Carga_Solar_Ajustado*Serie_Radiacion*To_MWh - Consumo_de_Solar_DG_por_Carga_baterias</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion eólica red" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion solar Red" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Merito Centro Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0 ,  Demanda_Centro_24h - Solar_Panel_DG_Centro_24h)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio Electricidad" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Generacion Tecnologias" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Centro dia ordenada">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Tecnologias[Costos_Ordenados[Indice_Tec]+1, Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion por\nTecnologia Hora Centro">
