				<units>MWh</units>
			</aux>
			<aux name="Capacidad Transmision\nenergia restante Stage2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Transmision_energia_restante_Stage1 - Exportacion_Eolica_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica Offshore\nCosta a Centro 24H" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
0
ELSE
MIN(Capacidad_Transmision_energia_restante_Stage2, Excedente_Energia_por_Horas_Costa[Wind_Offshore,Horas24])*Cambio_de_Regla</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad Eolica Offshore">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Copia_Generacion_disponible_Costa_Dia_Horas[10,Horas24] - Exportacion_Eolica_Offshore_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cambio de Regla Intercambio" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Converter 14">
				<eqn>Cambio_de_Regla_Intercambio</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Cambio de Regla">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Converter_14=1 THEN
Vector_24_Horas
ELSE
Vector_24_Horas - Factor_Noche</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vector 24 Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Capacidad Transmision\nenergia restante Stage 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Transmision_energia_restante_Stage2 - Exportacion_Eolica_Offshore_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica Offshore2\nCosta a Centro 24H" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
0
ELSE
MIN(Capacidad_Transmision_energia_restante_Stage_3, Excedente_Energia_por_Horas_Costa[Wind_Offshore2,Horas24])*Cambio_de_Regla</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad\nEolica Offshore 1">
				<dimensions>
