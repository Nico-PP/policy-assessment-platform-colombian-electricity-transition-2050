	<model name="Control">
		<variables>
			<aux name="Mes" access="output">
				<eqn>COUNTER(1, 13)</eqn>
				<units>month</units>
			</aux>
			<stock name="Año" access="output">
				<eqn>2021</eqn>
				<format precision="1"/>
				<inflow>Avance_Mes</inflow>
				<non_negative/>
				<units>Year</units>
			</stock>
			<flow name="Avance Mes">
				<eqn>IF(Mes=12 AND TIME &gt; 1)THEN
1
ELSE
0</eqn>
				<non_negative/>
				<units>Year/Months</units>
			</flow>
			<aux name="Poder Politico Verde" access="output">
				<eqn>IF(Democracia_Verde=1)THEN
1
ELSE
IF (Extractivismo_Verde=1) THEN
1
ELSE
IF (Greta=1) THEN
0
ELSE
IF(Quemando_la_Casa=1) THEN
0
ELSE
99</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Poder Ciudadano Verde" access="output">
				<eqn>IF(Democracia_Verde=1)THEN
1
ELSE
IF (Extractivismo_Verde=1) THEN
0
ELSE
IF (Greta=1) THEN
1
ELSE
IF(Quemando_la_Casa=1) THEN
0
ELSE
99</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Retraso entradas plantas" access="output">
				<eqn>Retraso_Entrada_Plantas_en_Años*Meses_por_Año</eqn>
				<units>Months</units>
			</aux>
			<aux name="BAU" access="output">
				<eqn>0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Retardo transmision" access="output">
				<eqn>Retardo_en_Transmision_en_Años*Meses_por_Año</eqn>
				<units>Months</units>
			</aux>
			<aux name="Fenomeno del Niño" access="output">
				<eqn>0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Retraso Entrada Plantas en Años">
				<eqn>0</eqn>
				<format precision="1"/>
				<units>Years</units>
			</aux>
			<aux name="Meses por Año">
				<eqn>12</eqn>
				<units>Month/Year</units>
			</aux>
			<aux name="Retardo en Transmision en Años">
				<eqn>0</eqn>
				<format precision="1"/>
				<units>Years</units>
			</aux>
			<aux name="Democracia Verde">
				<eqn>1</eqn>
