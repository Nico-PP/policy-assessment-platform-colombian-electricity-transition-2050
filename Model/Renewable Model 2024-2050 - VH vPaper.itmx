			<aux name="Energia Disponible desde Costa" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Año_en_Simulacion &lt;= Año_Cambio THEN
0
ELSE
Exportacion_Solar_Costa_a_Centro_Dia+Exportacion_Eolica_Costa_a_Centro_24H + Exportacion_Eolica_Offshore_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Previa Centro Post Autogen">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(Converter_8-Solar_Panel_DG_Centro , 0)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Switch Off Hidro" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
