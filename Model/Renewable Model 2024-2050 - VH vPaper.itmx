	<model name="Carga_Baterias_Costa_1">
		<variables>
			<aux name="Gen Tec1 Disp\npara Carga Previo">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Tec1_Gen_Dispo, Excedentes_Energia_Costa_Horas) * Factor_de_Recarga_de_Bateria_Tec_1 * 
Hora_Carga_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 0">
				<eqn>MIN(Gen_Tec1_Disp_para_Carga_Previo[H0],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Bateria Mwh">
				<eqn>&quot;Cap_Bateria_MWh_-_Input&quot;</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Hora Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Bateria H 1">
				<eqn>MIN(Bateria_O_H_0 + Gen_Tec1_Disp_para_Carga_Previo[H1],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 2">
				<eqn>MIN(Bateria_O_H_1 + Gen_Tec1_Disp_para_Carga_Previo[H2],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 3">
				<eqn>MIN(Bateria_O_H_2 + Gen_Tec1_Disp_para_Carga_Previo[H3],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 4">
				<eqn>MIN(Bateria_O_H_3 + Gen_Tec1_Disp_para_Carga_Previo[H4],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 5">
				<eqn>MIN(Bateria_O_H_4 + Gen_Tec1_Disp_para_Carga_Previo[H5],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 6">
