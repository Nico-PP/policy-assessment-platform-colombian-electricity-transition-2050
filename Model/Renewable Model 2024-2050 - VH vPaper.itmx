			<aux name="Crecimiento Demanda Saltos">
				<eqn>Año</eqn>
				<gf>
					<xscale min="2021" max="2050"/>
					<yscale min="0" max="2"/>
					<ypts>0.034,0.034,0.034,0.034,0.034,0.034,0.034,0.034,0.034,0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.05,0.065,0.065,0.065,0.065,0.065,0.065,0.065,0.065,0.065,0.065,0.065</ypts>
