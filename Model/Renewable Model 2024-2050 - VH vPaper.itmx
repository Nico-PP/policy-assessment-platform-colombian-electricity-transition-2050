					<eqn>Capacidad_Instalada[Oil] * FC_Termicas_Horario[H3] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="2, H4">
					<eqn>Capacidad_Instalada[Oil] * FC_Termicas_Horario[H4] * Ajuste_Unidad_Gen_12_horas</eqn>
				</element>
				<element subscript="2, H5">
					<eqn>Capacidad_Instalada[Oil] * FC_Termicas_Horario[H5] * Ajuste_Unidad_Gen_12_horas</eqn>
