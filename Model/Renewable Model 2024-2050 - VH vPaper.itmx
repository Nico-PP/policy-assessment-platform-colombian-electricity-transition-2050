	</model>
	<model name="Calculo_Previo_Gen_Costa_Dia">
		<variables>
			<aux name="Bolsa Inicial">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Demanda &gt; 0)THEN
Demanda
ELSE
0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Indice Precios">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Costo_Despacho_Ordenado_Centro_Tec_x_Time&gt;Precio_Electricidad_Centro_Tec_x_Time)THEN
1
ELSE
( IF(Costo_Despacho_Ordenado_Centro_Tec_x_Time=Precio_Electricidad_Centro_Tec_x_Time)THEN
 2
 ELSE 
0 )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Dia 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[1, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[1, Horas24]=2)THEN (
        IF(Bolsa_Inicial&gt;Generacion_Odernada[1, Horas24]) THEN
           Generacion_Odernada[1, Horas24]
        ELSE
           Bolsa_Inicial )
     ELSE
       Generacion_Odernada[1, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bolsa 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[1, Horas24]=1)THEN
   0
ELSE(
   IF(Indice_Precios[1, Horas24]=2)THEN
      IF(Bolsa_Inicial&gt;Gen_Dia_1)THEN
         (Bolsa_Inicial-Gen_Dia_1)
       ELSE( 0)
    ELSE (Bolsa_Inicial-Gen_Dia_1)
)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Precio Electricidad" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Costo para Despacho Ordenado" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>USD/kWh</units>
			</aux>
			<aux name="Generacion Odernada" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[2, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[2, Horas24]=2)THEN (
        IF(Ad_Bolsa_1&gt;Generacion_Odernada[2, Horas24]) THEN
           Generacion_Odernada[2, Horas24]
        ELSE
           Ad_Bolsa_1 )
     ELSE
       Generacion_Odernada[2, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bolsa 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[2, Horas24]=1)THEN
   0
ELSE(
   IF(Indice_Precios[2, Horas24]=2)THEN
      IF(Ad_Bolsa_1&gt;Gen_Dia_2)THEN
         (Ad_Bolsa_1-Gen_Dia_2)
       ELSE( 0)
    ELSE (Ad_Bolsa_1-Gen_Dia_2)
)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[3, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[3, Horas24]=2)THEN (
        IF(Ad_Bolsa_2&gt;Generacion_Odernada[3, Horas24]) THEN
           Generacion_Odernada[3, Horas24]
        ELSE
           Ad_Bolsa_2 )
     ELSE
       Generacion_Odernada[3, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 4">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[4, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[4, Horas24]=2)THEN (
        IF(Ad_Bolsa_3&gt;Generacion_Odernada[4, Horas24]) THEN
           Generacion_Odernada[4, Horas24]
        ELSE
           Ad_Bolsa_3 )
     ELSE
       Generacion_Odernada[4, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 5">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[5, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[5, Horas24]=2)THEN (
        IF(Ad_Bolsa_4&gt;Generacion_Odernada[5, Horas24]) THEN
           Generacion_Odernada[5, Horas24]
        ELSE
           Ad_Bolsa_4 )
     ELSE
       Generacion_Odernada[5, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 6">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[6, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[6, Horas24]=2)THEN (
        IF(Ad_Bolsa_5&gt;Generacion_Odernada[6, Horas24]) THEN
           Generacion_Odernada[6, Horas24]
        ELSE
           Ad_Bolsa_5 )
     ELSE
       Generacion_Odernada[6, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 7">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[7, Horas24]=1)THEN 
0 
ELSE 
   ( IF(Indice_Precios[7, Horas24]=2)THEN (
        IF(Ad_Bolsa_6&gt;Generacion_Odernada[7, Horas24]) THEN
           Generacion_Odernada[7, Horas24]
        ELSE
           Ad_Bolsa_6 )
     ELSE
       Generacion_Odernada[7, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Dia 8">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[8, Horas24]=1)THEN 
0
ELSE 
   ( IF(Indice_Precios[8, Horas24]=2)THEN (
        IF(Ad_Bolsa_7&gt;Generacion_Odernada[8, Horas24]) THEN
           Generacion_Odernada[8, Horas24]
        ELSE
           Ad_Bolsa_7 )
     ELSE
       Generacion_Odernada[8, Horas24] )</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bolsa 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF(Indice_Precios[3, Horas24]=1)THEN
   0
ELSE(
   IF(Indice_Precios[3, Horas24]=2)THEN
      IF(Ad_Bolsa_2&gt;Gen_Dia_3)THEN
         (Ad_Bolsa_2-Gen_Dia_3)
       ELSE( 0)
    ELSE (Ad_Bolsa_2-Gen_Dia_3)
)</eqn>
