	</model>
	<model name="Gen_Centro">
		<variables>
			<stock name="Demanda Centro 24h" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>INIT_Demanda_Centro_día*Demanda_Centro_Perfil_Horario_1</eqn>
				<format precision="0.1"/>
				<inflow>Crecimiento_demanda_Centro_día</inflow>
				<non_negative/>
				<units>MWh</units>
			</stock>
			<flow name="Crecimiento demanda Centro día">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda_Centro_24h * 
(IF(Poder_Ciudadano_Verde=1 AND Poder_Politico_Verde=1)THEN 
(IF TIME&lt; 108 THEN
0.034
ELSE
Crecimiento_Demanda)
ELSE
0.02
)/ (12*DT)</eqn>
				<non_negative/>
				<units>MWh/Months</units>
			</flow>
			<group name="Sector 1" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Costo_para_Despacho_Costa"/>
				<entity name="Hidro_Centro_a_Costa_Usada"/>
				<entity name="Factor_de_disponibilidad_eólica"/>
				<entity name="Año_Cambio_Regla_de_Linea"/>
				<entity name="Poder_Ciudadano_Verde"/>
				<entity name="Demanda_Centro_Perfil_Horario_1"/>
				<entity name="Capacidad_transmision_energia"/>
				<entity name="Microgeneracion_industria"/>
				<entity name="Exportacion_Eolica_Costa_a_Centro_Dia"/>
				<entity name="Generacion_por_Tecnologia_Costa_Horas"/>
				<entity name="Factor_de_carga_Oil"/>
				<entity name="Capacidad_Planta_Embalse_Regulacion"/>
				<entity name="Exportacion_solar_Red"/>
				<entity name="FC_Termicas_Horario"/>
				<entity name="Costo_para_Despacho_Centro"/>
				<entity name="Factor_de_carga_gas"/>
				<entity name="Exportacion_Eolica_Offshore_Costa_a_Centro_24H"/>
				<entity name="Factor_de_disponibilidad_solar"/>
				<entity name="Mes"/>
				<entity name="Ajuste_Unidad_Gen_12_horas"/>
				<entity name="Capacidad_Instalada_Baterias_Centro"/>
				<entity name="Costos_Ordenados"/>
				<entity name="Horas_descarga_Carga_Bombeo"/>
				<entity name="Exportacion_eólica_red"/>
				<entity name="FC_Centro_Solar_Horario"/>
				<entity name="Exportacion_Eolica_Costa_a_Centro_24H"/>
				<entity name="Factor_de_carga_run_of_the_river"/>
				<entity name="Ind_Tec_x_Time"/>
