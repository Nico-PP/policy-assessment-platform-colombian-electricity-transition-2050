			<aux name="Crecimiento Demanda" access="output" isee:autocreated="true">
				<eqn>IF SW_Demanda=0 THEN
0.034
ELSE
(IF SW_Demanda=1 THEN
Demanda_Constante
ELSE
SMTH3(Crecimiento_Demanda_Saltos, 12))</eqn>
				<format precision="0.0001"/>
				<units>unitless</units>
			</aux>
			<aux name="SW Demanda">
				<eqn>0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Demanda Constante">
				<eqn>0.05</eqn>
				<units>unitless</units>
			</aux>
