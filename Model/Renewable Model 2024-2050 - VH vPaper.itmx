				<element subscript="Wind_Offshore2, H23">
					<eqn>Generacion_Centro_dia_ordenada[18, H23]</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Factor de disponibilidad solar" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Costo para Despacho Ordenado" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>USD/kWh</units>
			</aux>
			<aux name="Exportar Energia Centro a Costa Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0 ,  Aux_Gen_Dips_Centro_Dia - Generacion_por_Tecnologia_Hora_Centro)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad transmision energia" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion por\nTecnologia Centro Noche">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Gas,*])</eqn>
				</element>
				<element subscript="Oil">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Oil,*])</eqn>
				</element>
				<element subscript="Coal">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Coal,*])</eqn>
				</element>
				<element subscript="Others">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Others,*])</eqn>
				</element>
				<element subscript="Wind">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Wind,*])</eqn>
				</element>
				<element subscript="Hydro">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Hydro,*])</eqn>
				</element>
				<element subscript="Solar">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Solar,*])</eqn>
				</element>
				<element subscript="Run_of_the_River">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Run_of_the_River,*])</eqn>
				</element>
				<element subscript="Hydrogen">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Hydrogen,*])</eqn>
				</element>
				<element subscript="Wind_Offshore">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Wind_Offshore,*])</eqn>
				</element>
				<element subscript="Battery">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Battery, *])</eqn>
				</element>
				<element subscript="Pump">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Pump,*])</eqn>
				</element>
				<element subscript="Geothermal">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Geothermal,*])</eqn>
				</element>
				<element subscript="Biomass">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Biomass,*])</eqn>
				</element>
				<element subscript="Element_15">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Element_15,*])</eqn>
				</element>
				<element subscript="Element_16">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Element_16,*])</eqn>
				</element>
				<element subscript="Element_17">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Element_17,*])</eqn>
				</element>
				<element subscript="Wind_Offshore2">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Noche[Wind_Offshore2,*])</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Mes" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>month</units>
			</aux>
			<aux name="Generacion Total Centro Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro[Gas,Horas24] +
Generacion_por_Tecnologia_Hora_Centro[Oil,Horas24] +
Generacion_por_Tecnologia_Hora_Centro[Coal,Horas24] + 
Generacion_por_Tecnologia_Hora_Centro[Others,Horas24] +
Generacion_por_Tecnologia_Hora_Centro[Wind,Horas24] + 
Generacion_por_Tecnologia_Hora_Centro[Hydro,Horas24] + 
Generacion_por_Tecnologia_Hora_Centro[Solar,Horas24] +
Generacion_por_Tecnologia_Hora_Centro[Run_of_the_River,Horas24]+
Generacion_por_Tecnologia_Hora_Centro[Battery,Horas24] +
Generacion_por_Tecnologia_Hora_Centro[Geothermal,Horas24]+Generacion_por_Tecnologia_Hora_Centro[Biomass,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Gen Total Disp Centro Dia">
				<eqn>SUM(Stage_3_Generacion_disponible_Centro_Horas)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Gen Renovable\nDisp Centro Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Stage_3_Generacion_disponible_Centro_Horas[8, Horas24]+Stage_3_Generacion_disponible_Centro_Horas[7, Horas24]+Stage_3_Generacion_disponible_Centro_Horas[6, Horas24]+Stage_3_Generacion_disponible_Centro_Horas[5, Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Total Centro Noche">
				<eqn>SUM(Generacion_por_Tecnologia_Centro_Noche)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Solar\nDistribuida Centro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Autogeneracion_Solar_Centro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Total Centro">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Centro_Dia + Generacion_por_Tecnologia_Centro_Noche</eqn>
				<isee:summing/>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Total Pais por Tecnologia">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Generacion_Total_Centro * SW_Kill_of_Import + Generacion_Total_Costa * SW_Kill_of_Import + Otras_Fuentes_de_Gen_Pais</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Otras Fuentes de Gen Pais">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
					<eqn>0</eqn>
				</element>
				<element subscript="Oil">
					<eqn>0</eqn>
				</element>
				<element subscript="Coal">
					<eqn>0</eqn>
				</element>
				<element subscript="Others">
					<eqn>0</eqn>
				</element>
				<element subscript="Wind">
					<eqn>Generacion_Total_Centro[Element_16]</eqn>
				</element>
				<element subscript="Hydro">
					<eqn>Generacion_Total_Costa[Element_15]</eqn>
				</element>
				<element subscript="Solar">
					<eqn>Generacion_Total_Centro[Element_15]</eqn>
				</element>
				<element subscript="Run_of_the_River">
					<eqn>0</eqn>
				</element>
				<element subscript="Hydrogen">
					<eqn>0</eqn>
				</element>
				<element subscript="Wind_Offshore">
					<eqn>Generacion_Total_Centro[Element_17]</eqn>
				</element>
				<element subscript="Battery">
					<eqn>0</eqn>
				</element>
				<element subscript="Pump">
					<eqn>0</eqn>
				</element>
				<element subscript="Geothermal">
					<eqn>0</eqn>
				</element>
				<element subscript="Biomass">
					<eqn>0</eqn>
				</element>
				<element subscript="Element_15">
					<eqn>0</eqn>
				</element>
				<element subscript="Element_16">
					<eqn>0</eqn>
				</element>
				<element subscript="Element_17">
					<eqn>0</eqn>
				</element>
				<element subscript="Wind_Offshore2">
					<eqn>0</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Solar\nDistribuida Costa" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Solar Panel DG Centro 24h" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Uso_Baterias_AutoGen_Centro + 
Autogeneracion_Solar_Centro ,
Demanda_Centro_24h)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Costa a Centro Por Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Exportacion_solar_Red + Exportacion_eólica_red +
Exportacion_Eolica_Offshore_Costa_a_Centro_24H +
Exportacion_Eolica_Offshore2_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Solar DG Pais 24h">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_Solar_Distribuida_Centro+Generacion_Solar_Distribuida_Costa</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Total Pais">
				<eqn>SUM(Generacion_Total_Pais_por_Tecnologia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="% Energia Tecnologia">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Generacion_Total_Pais_por_Tecnologia/Generacion_Total_Pais * 100</eqn>
				<format display_as="percent"/>
				<units>unitless</units>
			</aux>
			<aux name="Demanda Total Costa" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen vs Dem">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda_Merito_Centro_Horas-Generacion_Total_Centro_Dia</eqn>
				<units>MWh</units>
			</aux>
			<stock name="Embalse Tipo1">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>7000</eqn>
				<inflow>Aportes_al_Emb_Tipo1</inflow>
				<outflow>Generacion_de_Embalse_Tipo1</outflow>
				<outflow>Vertimiento_Tipo1</outflow>
				<non_negative/>
				<units>GWh</units>
			</stock>
			<flow name="Aportes al Emb Tipo1">
				<eqn>Aportes_Centro_Embalses_con_Regulacion/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<flow name="Generacion de Embalse Tipo1">
				<eqn>IF(Embalse_Tipo1-Despacho_Real_Emb_Tipo1_GWh+Aportes_al_Emb_Tipo1*DT&lt;Minimo_Embalse)THEN
(Embalse_Tipo1-Minimo_Embalse)/DT
ELSE
Despacho_Real_Emb_Tipo1_GWh/DT</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Fenomeno del Niño" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<stock name="Año" access="input">
				<eqn>2021</eqn>
				<non_negative/>
				<units>Year</units>
			</stock>
			<flow name="Vertimiento Tipo1">
				<eqn>IF(Aportes_al_Emb_Tipo1+Embalse_Tipo1/DT-Generacion_de_Embalse_Tipo1 &gt;= Maximo_Embalse/DT)THEN
Embalse_Tipo1/DT-Generacion_de_Embalse_Tipo1+Aportes_al_Emb_Tipo1-Maximo_Embalse/DT
ELSE
0</eqn>
				<non_negative/>
				<units>GWh/Months</units>
			</flow>
			<aux name="Maximo Embalse">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>8611</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Minimo Embalse">
				<doc>ver archivo datos aportes: hoja Embalses o Fuente directa: Paratec</doc>
				<eqn>1587</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Despacho Real Emb Tipo1 GWh">
				<eqn>SUM(Despacho_Real_Embalse_Tipo_1)  /Mwh_to_Gwh * 30 /Eficiencia_HidroGeneración</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Mwh to Gwh">
				<eqn>1000</eqn>
				<units>MWh/GWh</units>
			</aux>
			<aux name="Vol Efectivo">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Potencia_Real_Tipo1 + 
Potencia_Real_Tipo_2 +
Potencia_Real_Penol +
Potencia_Real_Punchina +
Potencia_Real_Bogota)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Switch Embalse" access="input">
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Filo de Agua">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MIN(Aportes_Filo_de_Agua_dia*DT, Gen_Disp_Hydro_Filo_de_Agua)*0+300</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Aportes Sensibilidad" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Serie Radiacion" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>hr</units>
			</aux>
			<aux name="Aportes Centro">
				<eqn>Aportes_Sensibilidad*&quot;Rel_Aportes_Centro_-_Costa&quot;</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Aportes Centro Embalse">
				<eqn>Aportes_Centro*&quot;%_Aportes_Centro&quot;+Aportes_HidroItuango</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Aportes Centro Filo de Agua">
				<eqn>Aportes_Centro*(1-&quot;%_Aportes_Centro&quot;)</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Rel Aportes Centro - Costa" access="output">
				<eqn>0.973057876</eqn>
				<units>unitless</units>
			</aux>
			<aux name="% Aportes Centro">
				<eqn>0.92</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Inc Capacidad Filo de Agua">
				<eqn>(Capacidad_Instalada_Centro[Run_of_the_River]/ INIT(Capacidad_Instalada_Centro[Run_of_the_River]) )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Aportes HidroItuango">
				<eqn>IF(TIME&lt;=1)THEN
1
ELSE
Aportes_Hidro_Ituango_2*Variación_Aportes</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Variación Aportes">
				<eqn>IF(TIME&lt;=1)THEN
1
ELSE
SAFEDIV(Aportes_Centro, PREVIOUS(Aportes_Centro, 1))</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Aportes Init HidroItuango">
				<eqn>Año</eqn>
				<gf>
					<xscale min="2020" max="2030"/>
					<yscale min="0" max="2400"/>
					<ypts>0,0,0,0,0,2390,2390,2390,2390,2390,2390</ypts>
				</gf>
				<units>GWh</units>
			</aux>
			<aux name="Aportes Hidro Ituango 2">
				<eqn>IF(Año&gt;=2024)THEN
Aportes_Init_HidroItuango
ELSE
0</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Eficiencia HidroGeneración">
				<eqn>0.90</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Crecimiento Demanda" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Renovable Noche">
				<eqn>Generacion_por_Tecnologia_Centro_Noche[Wind] +
Generacion_por_Tecnologia_Centro_Noche[Hydro] + 
Generacion_por_Tecnologia_Centro_Noche[Solar] +
Generacion_por_Tecnologia_Centro_Noche[Run_of_the_River]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Hidro Centro a Costa Usada" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="INIT Demanda Centro día">
				<eqn>86952.69917 + 64117.95371</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Centro Perfil Horario 1" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="FC Centro Solar Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="FC Termicas Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.87</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Factor de Carga Solar Ajustado" access="output">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>FC_Centro_Solar_Horario / SUM(FC_Centro_Solar_Horario)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Ind Tec x Time" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Aux Gen Dips Centro Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Stage_3_Generacion_disponible_Centro_Horas[Ind_Tec_x_Time,Horas24]</eqn>
				<init_eqn>0</init_eqn>
				<units>MWh</units>
			</aux>
			<aux name="FC Hydro Embalse" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.50</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Factor de Carga Hidro Ajustado">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>FC_Hydro_Embalse</eqn>
				<units>unitless</units>
			</aux>
			<aux name="FC Hydro Runof River" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.50</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Factor de Carga Filo Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Control.FC_Hydro_Run_of_River/SUM(Control.FC_Hydro_Run_of_River)}
0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Facfor Dia" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Factor Noche" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion por Tecnologia Hora Centro Noche">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro * Factor_Noche[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion por\nTecnologia Centro Dia">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<element subscript="Gas">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Gas,*])</eqn>
				</element>
				<element subscript="Oil">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Oil,*])</eqn>
				</element>
				<element subscript="Coal">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Coal,*])</eqn>
				</element>
				<element subscript="Others">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Others,*])</eqn>
				</element>
				<element subscript="Wind">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Wind,*])</eqn>
				</element>
				<element subscript="Hydro">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Hydro,*])</eqn>
				</element>
				<element subscript="Solar">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Solar,*])</eqn>
				</element>
				<element subscript="Run_of_the_River">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Run_of_the_River,*])</eqn>
				</element>
				<element subscript="Hydrogen">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Hydrogen,*])</eqn>
				</element>
				<element subscript="Wind_Offshore">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Wind_Offshore,*])</eqn>
				</element>
				<element subscript="Battery">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Battery,*])</eqn>
				</element>
				<element subscript="Pump">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Pump,*])</eqn>
				</element>
				<element subscript="Geothermal">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Geothermal,*])</eqn>
				</element>
				<element subscript="Biomass">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Biomass,*])</eqn>
				</element>
				<element subscript="Element_15">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Element_15,*])</eqn>
				</element>
				<element subscript="Element_16">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Element_16,*])</eqn>
				</element>
				<element subscript="Element_17">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Element_17,*])</eqn>
				</element>
				<element subscript="Wind_Offshore2">
					<eqn>SUM(Generacion_por_Tecnologia_Hora_Centro_Dia[Wind_Offshore2,*])</eqn>
				</element>
				<units>MWh</units>
			</aux>
			<aux name="Generacion por Tecnologia\nHora Centro Dia">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro * Facfor_Dia[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Disponible Costa por Tecnologia">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>SUM(Stage_3_Generacion_disponible_Centro_Horas[Indice_Tec,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Unidad MWh GWh">
				<eqn>1000</eqn>
				<units>MWh/GWh</units>
			</aux>
			<aux name="Generacion Hidro Disponible hora">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Instalada_Centro[Hydro] * FC_Hydro_Embalse *
Ajuste_Unidad_Gen_12_horas /
Mwh_to_Gwh * 30</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Generacion Hidro Disponible Dia 24h">
				<eqn>SUM(Generacion_Hidro_Disponible_hora)</eqn>
				<units>GWh</units>
			</aux>
			<aux name="Exportacion Costa\na Centro dia 12h">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Exportacion_Costa_a_Centro_Por_Horas *
Facfor_Dia</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Costa\na Centro dia">
				<eqn>SUM(Exportacion_Costa_a_Centro_dia_12h)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Costa\na Centro noche 12h">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Exportacion_Costa_a_Centro_Por_Horas *
Factor_Noche</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Costa\na Centro Noche">
				<eqn>SUM(Exportacion_Costa_a_Centro_noche_12h)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Solar DG Centro">
				<eqn>SUM(Autogeneracion_Solar_Centro * Facfor_Dia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Solar\nDistribuida Pais">
				<eqn>SUM(Solar_DG_Pais_24h)</eqn>
				<units>MWh</units>
			</aux>
			<group name="Disponibilidad Centro" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Stage1_Generacion_disponible_Centro_Horas_Sin_Baterias"/>
