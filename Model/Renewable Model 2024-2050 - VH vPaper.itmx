Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias[18,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedentes Energia Costa Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Energia_Disponible_Costa_Hora-Demanda_Costa_24h)</eqn>
				<units>MWh</units>
			</aux>
			<module name="Carga Baterias Costa 1">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<connect to="Carga_Baterias_Costa_1.Hora_Carga_Bateria" from="Gen_Costa.Horas_Carga_Baterias_Costa"/>
				<connect2 to="Carga_Baterias_Costa_1.Hora_Carga_Bateria" from="Horas_Carga_Baterias_Costa"/>
				<connect to="Carga_Baterias_Costa_1.Ajuste_Hora" from="Gen_Costa.Ajuste_Unidad_Gen_12_horas"/>
				<connect2 to="Carga_Baterias_Costa_1.Ajuste_Hora" from="Ajuste_Unidad_Gen_12_horas"/>
				<connect to='Carga_Baterias_Costa_1."Cap_Bateria_MWh_-_Input"' from="Gen_Costa.Cap_Baterias_2"/>
				<connect2 to='Carga_Baterias_Costa_1."Cap_Bateria_MWh_-_Input"' from="Cap_Baterias_2"/>
				<connect to="Carga_Baterias_Costa_1.Eficiencia_Bateria" from="Gen_Costa.Eficiencia_Batería"/>
				<connect2 to="Carga_Baterias_Costa_1.Eficiencia_Bateria" from="Eficiencia_Batería"/>
				<connect to="Gen_Costa.Uso_Wind_Onshore_por_Carga_Bateria" from="Carga_Baterias_Costa_1.Consumo_Tec_1_Por_Carga_de_Bateria"/>
				<connect2 to="Uso_Wind_Onshore_por_Carga_Bateria" from="Carga_Baterias_Costa_1.Consumo_Tec_1_Por_Carga_de_Bateria"/>
				<connect to="Carga_Baterias_Costa_1.Distribucion_Horas" from="Gen_Costa.Porcentaje_Faltantes"/>
				<connect2 to="Carga_Baterias_Costa_1.Distribucion_Horas" from="Porcentaje_Faltantes"/>
				<connect to="Carga_Baterias_Costa_1.Tec1_Gen_Dispo" from="Gen_Costa.Dispotnibilidad_Tec_1_Bat2"/>
				<connect2 to="Carga_Baterias_Costa_1.Tec1_Gen_Dispo" from="Dispotnibilidad_Tec_1_Bat2"/>
				<connect to="Gen_Costa.Uso_Wind_Offshore_por_Carga_Bateria" from="Carga_Baterias_Costa_1.Consumo_Tec_2_Por_Carga_de_Bateria"/>
				<connect2 to="Uso_Wind_Offshore_por_Carga_Bateria" from="Carga_Baterias_Costa_1.Consumo_Tec_2_Por_Carga_de_Bateria"/>
				<connect to="Carga_Baterias_Costa_1.Gen_Tec_2" from="Gen_Costa.Gen_Wind_Offshore_Disponible_Antes_de_Baterias"/>
				<connect2 to="Carga_Baterias_Costa_1.Gen_Tec_2" from="Gen_Wind_Offshore_Disponible_Antes_de_Baterias"/>
				<connect to="Carga_Baterias_Costa_1.Excedentes_Energia_Costa_Horas" from="Gen_Costa.Excedentes"/>
				<connect2 to="Carga_Baterias_Costa_1.Excedentes_Energia_Costa_Horas" from="Excedentes"/>
			</module>
			<aux name="Cap Baterias 2">
				<eqn>IF TIME &lt;= 120 THEN
0
ELSE
20000*0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedentes">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Excedentes_Energia_Costa_Horas-Uso_Tec1_por_Carga_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Eolico Offshore 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Energía_Series_viento_Total_Offshore*FC_Costa_Wind_Ajustado*Proporcion_Baterias_Offshore_a_Despachar</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Faltantes Energia\nCosta Horas">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Demanda_Costa_24h -  Energia_Disponible_Costa_Hora-Vol_Efectivo)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Porcentaje Faltantes">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Faltantes_Energia_Costa_Horas, SUM(Faltantes_Energia_Costa_Horas), 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Suma Faltantes">
				<eqn>SUM(Faltantes_Energia_Costa_Horas)</eqn>
				<units>MWh</units>
			</aux>
			<module name="Carga Baterias Costa 2">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
