	<model name="Carga_Baterias_Distribuidas_Centro">
		<variables>
			<aux name="Gen Solar Disp para Carga">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Converter_1*Factor_de_Recarga_de_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 0">
				<eqn>MIN(Gen_Solar_Disp_para_Carga[H0] * Hora_Carga_Bateria[H0],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Cap Bateria Mwh">
				<eqn>&quot;Cap_Bateria_MWh_-_Input&quot;</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Hora Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Bateria H 1">
				<eqn>MIN(Bateria_H_0 + Gen_Solar_Disp_para_Carga[H1] * Hora_Carga_Bateria[H1],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 2">
				<eqn>MIN(Bateria_H_1 + Gen_Solar_Disp_para_Carga[H2] * Hora_Carga_Bateria[H2],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 3">
				<eqn>MIN(Bateria_H_2 + Gen_Solar_Disp_para_Carga[H3] * Hora_Carga_Bateria[H3],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 4">
				<eqn>MIN(Bateria_H_3 + Gen_Solar_Disp_para_Carga[H4] * Hora_Carga_Bateria[H4],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 5">
				<eqn>MIN(Bateria_H_4 + Gen_Solar_Disp_para_Carga[H5] * Hora_Carga_Bateria[H5],  Cap_Bateria_Mwh)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Bateria H 6">
