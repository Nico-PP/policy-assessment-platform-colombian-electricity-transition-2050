			<aux name="Factor de Recarga de Bateria">
				<eqn>1

{Factor de carga para evitar usar el 100% de energía solar de la hora para cargar la bateria}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Hora Carga Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Horas Descarga" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Sol Disponible día">
				<eqn>SUM(Gen_Solar_Disp_para_Carga)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Energia Excedente" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Converter 2" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Porcentaje Faltantes" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Converter 3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Solar_Disp_para_Carga-Consumo_Solar_Por_Carga_de_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Suma Distribucion">
				<eqn>SUM(Distribucion_Horas_1)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Distribucion Horas 1">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Horas_Descarga</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Distribucion Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Distribucion_Horas_1, Suma_Distribucion, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Descarga para Faltantes">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Carga_Final_del_dia*Porcentaje_Faltantes * 10
{Factor de Importancia de Faltantes}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Descarga por Distribucion">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Carga_Final_del_dia*Distribucion_Ajustada</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Descarga">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Descarga_para_Faltantes*10 +Descarga_por_Distribucion
{factor de importantcia de los faltantes definidos}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Proporcion Ajustada">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Descarga, SUM(Descarga), 0)</eqn>
				<units>unitless</units>
			</aux>
		</variables>
