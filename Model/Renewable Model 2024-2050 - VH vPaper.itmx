			</aux>
			<aux name="Disponibilidad\nImportaciones Hydro">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Costa_Horas[Element_15,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad\nBaterias 2">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Consumo_Solar_Por_Carga_de_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Centro Real">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro + Ajustes_de_Generacion_Centro</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Consumo Eolico por Vateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Consumo Solar por Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad\nBaterias Solar">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Consumo_Solar_por_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica\nCosta a Centro 24H" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica Offshore\nCosta a Centro 24H" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Importacion Eolica\nde la Costa Offshore">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Exportacion_Eolica_Offshore_Costa_a_Centro_24H + Exportacion_Eolica_Offshore2_Costa_a_Centro_24H</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad Baterias Eolico Offshore">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Consumo_Offshore_por_Bateria</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad\nImportaciones Viento Offshore">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Generacion_por_Tecnologia_Hora_Centro[Element_17,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Consumo Offshore por Bateria" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Energia Disponible Costa Hora" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Pais 24H">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda_Centro_24h+Demanda_Costa_24h</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibildad Pais 24H">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Total_Centro_Disponible+Energia_Disponible_Costa_Hora</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Energia Excedente 24H">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Disponibildad_Pais_24H-Demanda_Pais_24H)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Total Excedente Pais 24H">
				<eqn>SUM(Energia_Excedente_24H)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Faltante Energia 24H">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0, Demanda_Pais_24H - Disponibildad_Pais_24H)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Total Fsltante Energia Pais">
				<eqn>SUM(Faltante_Energia_24H)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Vertimiento Tecnologia\nhora Total Costa">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Gen_Costa_Disponible_2 &lt;&gt; 0 THEN
1- SAFEDIV(Gen_Costa_Real, Gen_Costa_Disponible_2, 0)
ELSE 
0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimientos por\nTecnologia Total Costa">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>MEAN(Vertimiento_Tecnologia_hora_Total_Costa[Tecnologias,*])</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimiento Tecnologia\nhora Total Centro">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Gen_Centro_Disponible_2 &lt;&gt; 0 THEN
1- SAFEDIV(Gen_Centro_Real, Gen_Centro_Disponible_2, 0)
ELSE 
0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimientos por\nTecnologia Total Centro">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>MEAN(Vertimiento_Tecnologia_hora_Total_Centro[Tecnologias,*])</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Stage 1 Generacion disponible\nCosta Dia Horas\nSin Baterias" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Aux Gen Dips Costa">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias[Ind_Tec_x_Time,Horas24]</eqn>
				<init_eqn>0</init_eqn>
				<units>MWh</units>
			</aux>
			<group name="Calculos Vertimiento" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Uso_Tecnologia_hora_Renovable_Total"/>
				<entity name="Gen_Costa_Real"/>
				<entity name="Disponibilidad_Baterias_Solar"/>
				<entity name="Gen_Costa_Disponible_2"/>
				<entity name="Disponibilidad_T2"/>
				<entity name="Vertimientos_Renovables_en_Energia"/>
				<entity name="Consumo_Offshore_por_Bateria"/>
				<entity name="Uso_Tecnologia_hora_Total"/>
				<entity name="Vertimiento_Offshore_Pond"/>
				<entity name="Uso_Tecnologia_Costa"/>
				<entity name="Vertimientos_por_Tecnologia_Renovable_Total_Energia"/>
				<entity name="Consumo_Solar_por_Bateria"/>
				<entity name="stage3_Generacion_disponible_Costa_Dia_Horas"/>
				<entity name="Gen_Centro_Disponible_2"/>
				<entity name="Uso_Tecnologia_Total"/>
				<entity name="Vertimiento_en_Proporcion"/>
				<entity name="Ajustes_de_Generacion_Centro"/>
				<entity name="Vertimientos_por_Tecnologia_Total_Costa"/>
				<entity name="Disponibilidad_Baterias_Eolico_Offshore"/>
				<entity name="Uso_Tecnologia_Renovable_Total"/>
				<entity name="Vertimientos_por_Tecnologia_Total_Centro"/>
				<entity name="Gen_Centro_Real"/>
				<entity name="Vertimientos_por_Tecnologia_Total"/>
				<entity name="Vertimiento_Tecnologia_hora_Total_Costa"/>
				<entity name="Consumo_Eolico_por_Vateria"/>
				<entity name="Aux_Gen_Dips_Costa"/>
				<entity name="Disponibilidad_Importaciones_Viento_Offshore"/>
				<entity name="Generacion_T2"/>
				<entity name="Disp_OffshorePond"/>
				<entity name="Uso_Tecnologia_hora_Centro"/>
				<entity name="Disponibilidad_Importaciones_Hydro"/>
				<entity name="Disponibilidad_Importaciones_Sol"/>
				<entity name="Disponibilidad_Importaciones_Viento"/>
				<entity name="Disponibilidad_Baterias_2"/>
				<entity name="Disponibilidad_Baterias_Eolico"/>
				<entity name="Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias"/>
				<entity name="Vertimientos_por_Tecnologia_Renovable_Total"/>
				<entity name="Uso_Solar_por_Carga_Bateria"/>
				<entity name="Uso_Tecnologia_hora_Costa"/>
				<entity name="Gen_Renovable_Total_Pais"/>
				<entity name="Ajustes_de_Eolica_Generacion_Costa"/>
				<entity name="Gen_Disponible_Renovable_Total_Pais"/>
				<entity name="Gen_Real_Pais_por_Tech"/>
				<entity name="Vertimiento_Tecnologia_hora_Renovable_Total_Pais"/>
				<entity name="Uso_Tecnologia_Centro"/>
				<entity name="Gen_Disponible_Pais_por_Tech"/>
				<entity name="Gen_Total_Pais"/>
				<entity name="Vertimiento_Tecnologia_hora_Total_Pais"/>
				<entity name="Vertimiento_en_Energia"/>
				<entity name="Gen_Offshore_Pond"/>
				<entity name="Vertimiento_Tecnologia_hora_Total_Centro"/>
				<entity name="Gen_Disponible_Total_Pais"/>
			</group>
			<aux name="Gen Disponible Stage3">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Stage_3_Generacion_disponible_Centro_Horas[5,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[6,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[7,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[8,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[9,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[10,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[11,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[12,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[13,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[14,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[15,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[16,Horas24] + 
Stage_3_Generacion_disponible_Centro_Horas[17,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedente Energia">
				<eqn>SUM(Energia_Excedente)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Ajuste por Transmision de Energia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_transmision_energia*Horas_Ajuste</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Horas Ajuste">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<element subscript="H0">
					<eqn>0</eqn>
				</element>
				<element subscript="H1">
					<eqn>0</eqn>
				</element>
				<element subscript="H2">
					<eqn>0</eqn>
				</element>
				<element subscript="H3">
					<eqn>0</eqn>
				</element>
				<element subscript="H4">
					<eqn>0</eqn>
				</element>
				<element subscript="H5">
					<eqn>0</eqn>
				</element>
				<element subscript="H6">
					<eqn>0</eqn>
				</element>
				<element subscript="H7">
					<eqn>0</eqn>
				</element>
				<element subscript="H8">
					<eqn>0</eqn>
				</element>
				<element subscript="H9">
					<eqn>0</eqn>
				</element>
				<element subscript="H10">
					<eqn>0</eqn>
				</element>
				<element subscript="H11">
					<eqn>1</eqn>
				</element>
				<element subscript="H12">
					<eqn>1</eqn>
				</element>
				<element subscript="H13">
					<eqn>1</eqn>
				</element>
				<element subscript="H14">
					<eqn>1</eqn>
				</element>
				<element subscript="H15">
					<eqn>1</eqn>
				</element>
				<element subscript="H16">
					<eqn>0</eqn>
				</element>
				<element subscript="H17">
					<eqn>0</eqn>
				</element>
				<element subscript="H18">
					<eqn>0</eqn>
				</element>
				<element subscript="H19">
					<eqn>0</eqn>
				</element>
				<element subscript="H20">
					<eqn>0</eqn>
				</element>
				<element subscript="H21">
					<eqn>0</eqn>
				</element>
				<element subscript="H22">
					<eqn>0</eqn>
				</element>
				<element subscript="H23">
					<eqn>0</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Gen Disponible Renovable Total Pais">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Disponible_Total_Pais[Wind,Horas24] + 
Gen_Disponible_Total_Pais[Solar,Horas24] +
Gen_Disponible_Total_Pais[Wind_Offshore,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Renovable Total Pais">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Total_Pais[Wind,Horas24] +
Gen_Total_Pais[Solar,Horas24] + 
Gen_Total_Pais[Wind_Offshore,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Uso Tecnologia hora Renovable Total">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SAFEDIV(Gen_Renovable_Total_Pais, Gen_Disponible_Renovable_Total_Pais, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Uso Tecnologia Renovable Total">
				<eqn>MEAN(Uso_Tecnologia_hora_Renovable_Total)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimiento Tecnologia\nhora Renovable Total Pais">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>IF Gen_Disponible_Renovable_Total_Pais &lt;&gt; 0 THEN
1- SAFEDIV(Gen_Renovable_Total_Pais, Gen_Disponible_Renovable_Total_Pais, 0)
ELSE 
0</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimientos por\nTecnologia Renovable Total">
				<eqn>MEAN(Vertimiento_Tecnologia_hora_Renovable_Total_Pais)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Vertimientos\nRenovables en Energia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Disponible_Renovable_Total_Pais-Gen_Renovable_Total_Pais</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Vertimientos por\nTecnologia Renovable Total Energia">
				<eqn>SUM(Vertimientos_Renovables_en_Energia)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disponibilidad T2">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>SUM(Gen_Disponible_Total_Pais[Tecnologias,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion T2">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>SUM(Gen_Total_Pais[Tecnologias,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Vertimiento en Proporcion">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>SAFEDIV((Disponibilidad_T2-Generacion_T2), Disponibilidad_T2, 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Total Vertimientos Hydro Mwh">
				<eqn>Total_Vertimientos_Hydro_GWh * Unidad_MWh_GWh/30</eqn>
				<units>MWh/Month</units>
			</aux>
			<aux name="Vertimiento en Energia">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Disponibilidad_T2-Generacion_T2</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Disp OffshorePond">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Disponible_Total_Pais[Wind_Offshore,Horas24] + 
Gen_Disponible_Total_Pais[Wind_Offshore2,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Offshore Pond">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Gen_Total_Pais[Wind_Offshore,Horas24] +
Gen_Total_Pais[Wind_Offshore2,Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Vertimiento Offshore Pond">
				<eqn>SAFEDIV((SUM(Disp_OffshorePond) - SUM(Gen_Offshore_Pond)), SUM(Disp_OffshorePond), 0)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Gen Pais por Hora">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>SUM(Gen_Pais_por_Tech_Hora[*,Horas24])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Demanda Vs Generacion por Hora">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Demanda_Pais_24H - Gen_Pais_por_Hora -Solar_DG_Pais_24h -Solar_DG_Battery_Pais_24h</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Total Faltantes de Energia">
				<eqn>SUM(Demanda_Vs_Generacion_por_Hora)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="stage3 Generacion disponible\nCosta Dia Horas" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Gen Disponible Pais por Tech">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>SUM(Gen_Disponible_Total_Pais[Tecnologias,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Gen Real Pais por Tech">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>SUM(Gen_Total_Pais[Tecnologias,*])</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Exportacion Eolica Offshore2\nCosta a Centro 24H" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
		</variables>
