				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="Ajuste Unidad Gen 12 horas" access="input">
				<eqn>12</eqn>
				<units>MWh/MW</units>
			</aux>
			<aux name="Capacidad Instalada Centro" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>0</eqn>
				<units>MW</units>
			</aux>
			<aux name="Factor de carga Hidro" access="input">
				<eqn>0.65 * 
(IF ((Fenomeno_del_Niño = 1) AND
( (Año=2023) OR (Año=2028) OR (Año=2030) ) ) THEN 0.55 ELSE 1 )</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Factor de disponibilidad eólica" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Ranking Costo para Despacho" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Costos Ordenados" access="input">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Disp Centro Dia Ordenada">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<element subscript="1, H0">
					<eqn>Stage_3_Generacion_disponible_Centro_Horas[Ranking_Costo_para_Despacho[1],H0]</eqn>
				</element>
				<element subscript="1, H1">
					<eqn>Stage_3_Generacion_disponible_Centro_Horas[Ranking_Costo_para_Despacho[1],H1]</eqn>
