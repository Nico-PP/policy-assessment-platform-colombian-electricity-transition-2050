			</aux>
			<aux name="Year" access="input">
				<eqn>2021</eqn>
				<units>Year</units>
			</aux>
			<aux name="Crecimiento Oferta">
				<eqn>IF ( (Year MOD 1 )=0 AND Mes = 1 ) THEN
200
ELSE
0</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Mes" access="input">
				<eqn>1</eqn>
				<units>month</units>
			</aux>
			<aux name="Ajuste Unidad Mwh/Mw">
				<eqn>24</eqn>
				<units>MWh/MW</units>
			</aux>
			<aux name="Capacidad a Instalar Costa" access="output">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<eqn>Generacion_Necesaria*Porcentaje/Mwh_per_day</eqn>
				<format precision="full"/>
				<units>MW</units>
			</aux>
			<aux name="Factores de Carga Tecnologia" access="input">
				<dimensions>
					<dim name="Tecnologias"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Ajuste Disponibilidad">
				<eqn>IF TIME &lt;=120 THEN
1
ELSE
0.75</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Demanda Objetivo Region">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<element subscript="Centro">
					<eqn>SUM(Demanda_Objetivo_Region_24h[Centro,*])</eqn>
				</element>
				<element subscript="Costa">
					<eqn>SUM(Demanda_Objetivo_Region_24h[Costa,*])</eqn>
				</element>
				<format precision="1"/>
				<units>MWh</units>
			</aux>
			<aux name="FC Centro Solar Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="FC Termicas Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.87</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura Gas">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Gas,Region] *FC_Termicas_Horario[Horas24] *Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Futura Oil">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Oil,Region] *FC_Termicas_Horario[Horas24] *Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Futura Coal">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Coal,Region] *FC_Termicas_Horario[Horas24] * Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Futura Others">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Others,Region] * FC_Termicas_Horario[Horas24] * Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Ajuste Unidad Gen 12 horas" access="input">
				<eqn>1</eqn>
				<units>MWh/MW</units>
			</aux>
			<aux name="Serie Radiacion" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>hr</units>
			</aux>
			<aux name="FC Hydro Embalse" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>0.65</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura Hydro">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Capacidad_Futura[Hydro,Region] *
FC_Hydro_Embalse[Horas24] *
Ajuste_Unidad_Gen_12_horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad Molino" access="input">
				<eqn>4</eqn>
				<units>MW</units>
			</aux>
			<aux name="Molinos Region">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Capacidad_Futura[Wind,Region]/Capacidad_Molino</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Energía Viento" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MW</units>
			</aux>
			<aux name="Generacion Futura Wind Region">
				<dimensions>
					<dim name="Region"/>
				</dimensions>
				<eqn>Molinos_Region*Energía_Viento*Horas_Dias*To_MWH</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Horas Dias" access="input">
				<eqn>1</eqn>
				<units>hour</units>
			</aux>
			<aux name="To MWH" access="input">
				<eqn>1</eqn>
				<units>MWh/(MW*hour)</units>
			</aux>
			<aux name="FC Centro Wind Horario" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>unitless</units>
			</aux>
			<aux name="Generacion Futura Wind">
				<dimensions>
					<dim name="Region"/>
					<dim name="Horas24"/>
				</dimensions>
