	<model name="Transmision_entre_Zonas">
		<variables>
			<group name="Sector 1" run="false">
				<format precision="auto" scale_by="-1" delimit_000s="false"/>
				<entity name="Año"/>
				<entity name="Copia_Generacion_disponible_Costa_Dia_Horas_1"/>
				<entity name="Cambio_de_Regla_Intercambio"/>
				<entity name="Converter_8"/>
				<entity name="Costo_para_Despacho_Costa_Dia_1"/>
				<entity name="Facfor_Noche"/>
				<entity name="Capacidad_transmision_energia"/>
				<entity name="Converter_13"/>
				<entity name="Costo_para_Despacho_Centro"/>
				<entity name="Indice_Vector_Tec_2"/>
				<entity name="Converter_4"/>
				<entity name="Ind_Tec_x_Time"/>
				<entity name="Año_Cambio_Regla_de_Linea"/>
				<entity name="Facfor_Dia"/>
				<entity name="Indice_Tecnologias"/>
			</group>
			<aux name="Converter 4" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Req Energia\nRenovable Costa Noche">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Demanda_Merito_Costa_Dia - Generación_Renovable_Costa_24h) * Factor_Noche</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Converter 8" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<units>MWh</units>
			</aux>
			<aux name="Generacion Dispo Centro 24 horas">
				<dimensions>
					<dim name="Indice_Tec"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Copia_Generacion_disponible_Centro_Horas</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Converter 13" access="input">
				<units>MW</units>
			</aux>
			<aux name="Excedente Energia Renovable Costa Noche">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>Excedente_Energia_por_Horas_Costa * Factor_Noche[Horas24]</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Capacidad transmision energia" access="input">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Indice Vector Tec" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Indice_Vector_Tec_2</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Req Energia Renovable\nCosta Dia">
				<dimensions>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>(Demanda_Merito_Costa_Dia - Generación_Renovable_Costa_24h)*Factor_Dia</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Excedente Energia\npor Horas Costa">
				<dimensions>
					<dim name="Tecnologias"/>
					<dim name="Horas24"/>
				</dimensions>
				<eqn>MAX(0 , Copia_Generacion_disponible_Costa_Dia_Horas[Indice_Tecnologias[Tecnologias],Horas24 ]-Generacion_por_Tecnologia_Costa)</eqn>
				<units>MWh</units>
			</aux>
			<aux name="Costo para Despacho\nCosta Dia" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Costo_para_Despacho_Costa_Dia_1</eqn>
				<units>USD/kWh</units>
			</aux>
			<aux name="Ranking Costo para\nDespacho">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<element subscript="1">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 1)</eqn>
				</element>
				<element subscript="2">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 2)</eqn>
				</element>
				<element subscript="3">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 3)</eqn>
				</element>
				<element subscript="4">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 4)</eqn>
				</element>
				<element subscript="5">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 5)</eqn>
				</element>
				<element subscript="6">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 6)</eqn>
				</element>
				<element subscript="7">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 7)</eqn>
				</element>
				<element subscript="8">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 8)</eqn>
				</element>
				<element subscript="9">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 9)</eqn>
				</element>
				<element subscript="10">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 10)</eqn>
				</element>
				<element subscript="11">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 11)</eqn>
				</element>
				<element subscript="12">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 12)</eqn>
				</element>
				<element subscript="13">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 13)</eqn>
				</element>
				<element subscript="14">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 14)</eqn>
				</element>
				<element subscript="15">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 15)</eqn>
				</element>
				<element subscript="16">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 16)</eqn>
				</element>
				<element subscript="17">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 17)</eqn>
				</element>
				<element subscript="18">
					<eqn>RANK(Costo_para_Despacho_Costa_Dia, 18)</eqn>
				</element>
				<units>unitless</units>
			</aux>
			<aux name="Costo para Despacho\nOrdenado Costa Dia" access="output">
				<dimensions>
					<dim name="Indice_Tec"/>
				</dimensions>
				<eqn>Costo_para_Despacho_Costa_Dia[Ranking_Costo_para_Despacho]</eqn>
				<format precision="full"/>
				<units>USD/kWh</units>
			</aux>
			<aux name="Costos Ordenados Costa Dia">
				<dimensions>
