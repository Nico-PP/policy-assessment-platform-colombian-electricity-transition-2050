				</dimensions>
				<eqn>Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias[5,Horas24] +
Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias[6,Horas24] +
Stage_1_Generacion_disponible_Costa_Dia_Horas_Sin_Baterias[7,Horas24] +
